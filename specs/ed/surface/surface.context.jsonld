{
  "@context": {
    "@version": 1.1,
    "ujgsurface": "https://ujg.specs.openuji.org/ed/ns/surface#",
    "Surface": "ujgsurface:Surface",
    "SurfaceInstance": "ujgsurface:SurfaceInstance",
    "Touchpoint": "ujgsurface:Touchpoint",
    "Persona": "ujgsurface:Persona",
    "graphNode": {
      "@id": "ujgsurface:graphNode",
      "@type": "@id"
    },
    "surface": {
      "@id": "ujgsurface:surface",
      "@type": "@id"
    },
    "touchpoints": {
      "@id": "ujgsurface:touchpoints",
      "@type": "@id",
      "@container": "@set"
    },
    "journeys": {
      "@id": "ujgsurface:journeys",
      "@type": "@id",
      "@container": "@set"
    },
    "channel": "ujgsurface:channel"
  }
}
