@prefix ujggraph: <https://ujg.specs.openuji.org/ed/ns/graph#> .
@prefix ujgobservability: <https://ujg.specs.openuji.org/ed/ns/observability#> .
@prefix ujgoperability: <https://ujg.specs.openuji.org/ed/ns/operability#> .
@prefix ujgoperabilityshape: <https://ujg.specs.openuji.org/ed/ns/operability.shape#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ujgoperabilityshape:LocatorShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:or (
    [ sh:class ujgobservability:AccessibleLocator ]
    [ sh:class ujgobservability:CustomLocator ]
  ) .

ujgoperabilityshape:MaterializedTransitionShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:or (
    [ sh:class ujggraph:Transition ]
    [ sh:class ujggraph:AdjacentTransition ]
    [ sh:class ujggraph:OutgoingTransition ]
    [ sh:class ujggraph:InvokingTransition ]
  ) .

ujgoperabilityshape:MaterializationStepShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:or (
    [ sh:class ujgoperability:MoveStep ]
    [ sh:class ujgoperability:ActivationStep ]
    [ sh:class ujgoperability:ShortcutStep ]
  ) .

ujgoperabilityshape:TransitionMaterializationShape a sh:NodeShape ;
  sh:targetClass ujgoperability:TransitionMaterialization ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujgoperability:materializationTransition ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node ujgoperabilityshape:MaterializedTransitionShape ;
    sh:message "A TransitionMaterialization must declare exactly one materializationTransition that references a Transition, AdjacentTransition, OutgoingTransition, or InvokingTransition." ;
  ] ;

  sh:property [
    sh:path ujgoperability:materializationModality ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class ujgobservability:InputModality ;
    sh:nodeKind sh:IRI ;
    sh:message "A TransitionMaterialization must declare exactly one materializationModality that references an InputModality." ;
  ] ;

  sh:property [
    sh:path ujgoperability:materializationSteps ;
    sh:minCount 1 ;
    sh:node ujgoperabilityshape:MaterializationStepShape ;
    sh:message "A TransitionMaterialization must declare at least one materializationSteps value, and each must reference a MoveStep, ActivationStep, or ShortcutStep." ;
  ] ;

  sh:property [
    sh:path ujgoperability:materializationStartLocator ;
    sh:maxCount 1 ;
    sh:node ujgoperabilityshape:LocatorShape ;
    sh:message "A TransitionMaterialization may declare at most one materializationStartLocator, and it must reference an AccessibleLocator or CustomLocator." ;
  ] ;

  sh:property [
    sh:path ujgoperability:materializationSourceState ;
    sh:maxCount 1 ;
    sh:class ujggraph:State ;
    sh:nodeKind sh:IRI ;
    sh:message "A TransitionMaterialization may declare at most one materializationSourceState, and it must reference a State." ;
  ] ;

  sh:property [
    sh:path ujgoperability:materializationDirection ;
    sh:maxCount 1 ;
    sh:in ( ujgoperability:forward ujgoperability:backward ) ;
    sh:message "A TransitionMaterialization may declare at most one materializationDirection, and it must be ujgoperability:forward or ujgoperability:backward." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A Transition with fromExit is taken when the child exit is reached, not by a user action, so it has no TransitionMaterialization. Materialize the child Journey's Transition into that exit instead." ;
    sh:select """
      SELECT $this ?transition
      WHERE {
        $this ujgoperability:materializationTransition ?transition .
        ?transition ujggraph:fromExit ?exit .
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A TransitionMaterialization of an AdjacentTransition must declare materializationDirection." ;
    sh:select """
      SELECT $this ?transition
      WHERE {
        $this ujgoperability:materializationTransition ?transition .
        ?transition a ujggraph:AdjacentTransition .

        FILTER (NOT EXISTS {
          $this ujgoperability:materializationDirection ?direction .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Only a TransitionMaterialization of an AdjacentTransition declares materializationDirection." ;
    sh:select """
      SELECT $this ?transition
      WHERE {
        $this ujgoperability:materializationDirection ?direction ;
              ujgoperability:materializationTransition ?transition .

        FILTER (NOT EXISTS {
          ?transition a ujggraph:AdjacentTransition .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A materializationSourceState must reference a State that lists the materialized entry transition in entryTransitions, or a State nested in the CompositeState that the materialized transition leaves." ;
    sh:select """
      SELECT $this ?state
      WHERE {
        $this ujgoperability:materializationSourceState ?state ;
              ujgoperability:materializationTransition ?transition .

        FILTER (NOT EXISTS {
          ?state ujggraph:entryTransitions ?transition .
        })

        FILTER (NOT EXISTS {
          {
            ?transition a ujggraph:Transition ;
                        ujggraph:from ?left .
          }
          UNION
          {
            ?transition a ujggraph:AdjacentTransition ;
                        ujggraph:from ?left .
            $this ujgoperability:materializationDirection ujgoperability:forward .
          }
          UNION
          {
            ?transition a ujggraph:AdjacentTransition ;
                        ujggraph:to ?left .
            $this ujgoperability:materializationDirection ujgoperability:backward .
          }

          ?left a ujggraph:CompositeState ;
                (ujggraph:subjourneys/ujggraph:states)+ ?state .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A TransitionMaterialization must have a first step: one of its materializationSteps values that declares no previousStep." ;
    sh:select """
      SELECT $this
      WHERE {
        $this ujgoperability:materializationSteps ?someStep .

        FILTER (NOT EXISTS {
          $this ujgoperability:materializationSteps ?first .
          FILTER (NOT EXISTS {
            ?first ujgoperability:previousStep ?previous .
          })
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A TransitionMaterialization must have exactly one first step; only one of its materializationSteps values may omit previousStep." ;
    sh:select """
      SELECT $this ?first
      WHERE {
        $this ujgoperability:materializationSteps ?first, ?otherFirst .
        FILTER (?first != ?otherFirst)

        FILTER (NOT EXISTS {
          ?first ujgoperability:previousStep ?previous .
        })
        FILTER (NOT EXISTS {
          ?otherFirst ujgoperability:previousStep ?otherPrevious .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A step's previousStep must reference a step listed in the same TransitionMaterialization's materializationSteps." ;
    sh:select """
      SELECT $this ?step ?previous
      WHERE {
        $this ujgoperability:materializationSteps ?step .
        ?step ujgoperability:previousStep ?previous .

        FILTER (NOT EXISTS {
          $this ujgoperability:materializationSteps ?previous .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Two steps of one TransitionMaterialization must not follow the same step." ;
    sh:select """
      SELECT $this ?previous
      WHERE {
        $this ujgoperability:materializationSteps ?step, ?otherStep .
        FILTER (?step != ?otherStep)

        ?step ujgoperability:previousStep ?previous .
        ?otherStep ujgoperability:previousStep ?previous .
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A pointer moves directly to an object, so a MoveStep of a TransitionMaterialization through ujgobservability:pointer must not use a FocusMoveKind." ;
    sh:select """
      SELECT $this ?step ?kind
      WHERE {
        $this ujgoperability:materializationModality ujgobservability:pointer ;
              ujgoperability:materializationSteps ?step .
        ?step ujgoperability:stepMoveKind ?kind .
        ?kind a ujgoperability:FocusMoveKind .
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Only a TransitionMaterialization through ujgobservability:pointer uses ujgoperability:pointAt." ;
    sh:select """
      SELECT $this ?step
      WHERE {
        $this ujgoperability:materializationSteps ?step .
        ?step ujgoperability:stepMoveKind ujgoperability:pointAt .

        FILTER (NOT EXISTS {
          $this ujgoperability:materializationModality ujgobservability:pointer .
        })
      }
    """ ;
  ] .

ujgoperabilityshape:MoveStepShape a sh:NodeShape ;
  sh:targetClass ujgoperability:MoveStep ;
  sh:nodeKind sh:IRI ;
  sh:not [ sh:class ujgoperability:ActivationStep ] ;
  sh:not [ sh:class ujgoperability:ShortcutStep ] ;
  sh:message "A MoveStep must be identified by an IRI and must not also be an ActivationStep or ShortcutStep." ;

  sh:property [
    sh:path ujgoperability:stepMoveKind ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:class ujgoperability:FocusMoveKind ]
      [ sh:class ujgoperability:MoveKind ]
    ) ;
    sh:message "A MoveStep may declare at most one stepMoveKind, and it must reference a FocusMoveKind or a MoveKind." ;
  ] .

ujgoperabilityshape:ActivationStepShape a sh:NodeShape ;
  sh:targetClass ujgoperability:ActivationStep ;
  sh:nodeKind sh:IRI ;
  sh:not [ sh:class ujgoperability:ShortcutStep ] ;
  sh:message "An ActivationStep must be identified by an IRI and must not also be a ShortcutStep." .

ujgoperabilityshape:MaterializationStepPropertiesShape a sh:NodeShape ;
  sh:targetClass ujgoperability:MoveStep, ujgoperability:ActivationStep, ujgoperability:ShortcutStep ;

  sh:property [
    sh:path ujgoperability:stepLocator ;
    sh:maxCount 1 ;
    sh:node ujgoperabilityshape:LocatorShape ;
    sh:message "A materialization step may declare at most one stepLocator, and it must reference an AccessibleLocator or CustomLocator." ;
  ] ;

  sh:property [
    sh:path ujgoperability:previousStep ;
    sh:maxCount 1 ;
    sh:node ujgoperabilityshape:MaterializationStepShape ;
    sh:message "A materialization step may declare at most one previousStep, and it must reference a MoveStep, ActivationStep, or ShortcutStep." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A materialization step must be listed in exactly one TransitionMaterialization's materializationSteps." ;
    sh:select """
      SELECT $this
      WHERE {
        FILTER (NOT EXISTS {
          ?materialization ujgoperability:materializationSteps $this .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A materialization step must be listed in exactly one TransitionMaterialization's materializationSteps." ;
    sh:select """
      SELECT $this ?materialization
      WHERE {
        ?materialization ujgoperability:materializationSteps $this .
        ?otherMaterialization ujgoperability:materializationSteps $this .
        FILTER (?materialization != ?otherMaterialization)
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Materialization steps must not follow each other in a cycle." ;
    sh:select """
      SELECT $this
      WHERE {
        $this ujgoperability:previousStep+ $this .
      }
    """ ;
  ] .

ujgoperabilityshape:FocusMoveKindShape a sh:NodeShape ;
  sh:targetClass ujgoperability:FocusMoveKind ;
  sh:nodeKind sh:IRI ;
  sh:not [ sh:class ujgoperability:MoveKind ] ;
  sh:message "A FocusMoveKind must be identified by an IRI and must not also be a MoveKind." .

ujgoperabilityshape:MoveKindShape a sh:NodeShape ;
  sh:targetClass ujgoperability:MoveKind ;
  sh:nodeKind sh:IRI .

ujgoperabilityshape:MaterializationDirectionShape a sh:NodeShape ;
  sh:targetClass ujgoperability:MaterializationDirection ;
  sh:nodeKind sh:IRI ;
  sh:in ( ujgoperability:forward ujgoperability:backward ) ;
  sh:message "A MaterializationDirection must be ujgoperability:forward or ujgoperability:backward." .

ujgoperabilityshape:MaterializationTransitionSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujgoperability:materializationTransition ;
  sh:class ujgoperability:TransitionMaterialization ;
  sh:message "Only a TransitionMaterialization declares materializationTransition." .

ujgoperabilityshape:MaterializationModalitySubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujgoperability:materializationModality ;
  sh:class ujgoperability:TransitionMaterialization ;
  sh:message "Only a TransitionMaterialization declares materializationModality." .

ujgoperabilityshape:MaterializationStepSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujgoperability:materializationSteps ;
  sh:class ujgoperability:TransitionMaterialization ;
  sh:message "Only a TransitionMaterialization declares materializationSteps." .

ujgoperabilityshape:MaterializationStartLocatorSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujgoperability:materializationStartLocator ;
  sh:class ujgoperability:TransitionMaterialization ;
  sh:message "Only a TransitionMaterialization declares materializationStartLocator." .

ujgoperabilityshape:MaterializationSourceStateSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujgoperability:materializationSourceState ;
  sh:class ujgoperability:TransitionMaterialization ;
  sh:message "Only a TransitionMaterialization declares materializationSourceState." .

ujgoperabilityshape:MaterializationDirectionSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujgoperability:materializationDirection ;
  sh:class ujgoperability:TransitionMaterialization ;
  sh:message "Only a TransitionMaterialization declares materializationDirection." .

ujgoperabilityshape:StepPreviousSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujgoperability:previousStep ;
  sh:node ujgoperabilityshape:MaterializationStepShape ;
  sh:message "Only a MoveStep, ActivationStep, or ShortcutStep declares previousStep." .

ujgoperabilityshape:StepLocatorSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujgoperability:stepLocator ;
  sh:node ujgoperabilityshape:MaterializationStepShape ;
  sh:message "Only a MoveStep, ActivationStep, or ShortcutStep declares stepLocator." .

ujgoperabilityshape:StepMoveKindSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujgoperability:stepMoveKind ;
  sh:class ujgoperability:MoveStep ;
  sh:message "Only a MoveStep declares stepMoveKind." .
