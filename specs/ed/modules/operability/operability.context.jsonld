{
  "@context": {
    "@version": 1.1,
    "ujgoperability": "https://ujg.specs.openuji.org/ed/ns/operability#",
    "TransitionMaterialization": "ujgoperability:TransitionMaterialization",
    "MoveStep": "ujgoperability:MoveStep",
    "ActivationStep": "ujgoperability:ActivationStep",
    "ShortcutStep": "ujgoperability:ShortcutStep",
    "FocusMoveKind": "ujgoperability:FocusMoveKind",
    "MoveKind": "ujgoperability:MoveKind",
    "MaterializationDirection": "ujgoperability:MaterializationDirection",
    "materializationTransition": {
      "@id": "ujgoperability:materializationTransition",
      "@type": "@id"
    },
    "materializationModality": {
      "@id": "ujgoperability:materializationModality",
      "@type": "@id"
    },
    "materializationSteps": {
      "@id": "ujgoperability:materializationSteps",
      "@type": "@id",
      "@container": "@set"
    },
    "materializationStartLocator": {
      "@id": "ujgoperability:materializationStartLocator",
      "@type": "@id"
    },
    "materializationSourceState": {
      "@id": "ujgoperability:materializationSourceState",
      "@type": "@id"
    },
    "materializationDirection": {
      "@id": "ujgoperability:materializationDirection",
      "@type": "@id"
    },
    "previousStep": {
      "@id": "ujgoperability:previousStep",
      "@type": "@id"
    },
    "stepLocator": {
      "@id": "ujgoperability:stepLocator",
      "@type": "@id"
    },
    "stepMoveKind": {
      "@id": "ujgoperability:stepMoveKind",
      "@type": "@id"
    }
  }
}
