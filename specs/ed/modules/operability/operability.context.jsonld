    "TransitionMaterialization": "ujgoperability:TransitionMaterialization",
    "MoveStep": "ujgoperability:MoveStep",
    "ActivationStep": "ujgoperability:ActivationStep",
    "ShortcutStep": "ujgoperability:ShortcutStep",
    "MoveKind": "ujgoperability:MoveKind",
    "MaterializationDirection": "ujgoperability:MaterializationDirection",

    "materializationTransitionRef": {
      "@id": "ujgoperability:materializationTransitionRef",
      "@type": "@id"
    },
    "materializationModalityRef": {
