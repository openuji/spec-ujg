      "@container": "@set"
    },
    "materializationStartLocatorRef": {
      "@id": "ujgoperability:materializationStartLocatorRef",
      "@type": "@id"
    },
    "materializationSourceStateRef": {
      "@id": "ujgoperability:materializationSourceStateRef",
      "@type": "@id"
    },
    "materializationDirectionRef": {
      "@id": "ujgoperability:materializationDirectionRef",
      "@type": "@id"
    },
    "stepPreviousRef": {
      "@id": "ujgoperability:stepPreviousRef",
      "@type": "@id"
    },
    "stepLocatorRef": {
      "@id": "ujgoperability:stepLocatorRef",
      "@type": "@id"
    },
    "stepMoveKindRef": {
      "@id": "ujgoperability:stepMoveKindRef",
      "@type": "@id"
    }
  }
}
