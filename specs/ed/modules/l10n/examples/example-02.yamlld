"@context":
  - https://ujg.specs.openuji.org/ed/ns/context.jsonld
  - https://ujg.specs.openuji.org/ed/ns/l10n.context.jsonld
id: https://example.com/ujg/l10n/checkout.jsonld
type: UJGDocument
nodes:
  - type: Locale
    id: urn:l10n:locale:en
    localeCode: en
  - type: Locale
    id: urn:l10n:locale:de
    localeCode: de
  - type: State
    id: urn:ujg:state:order-confirmation
    label: Order confirmation
    copy: urn:l10n:message-meta:order-confirmation-title
  - type: MessageMeta
    id: urn:l10n:message-meta:order-confirmation-title
    argumentNames:
      - orderNumber
    defaultLocale: urn:l10n:locale:en
    fallbackLocales:
      - urn:l10n:locale:en
      - urn:l10n:locale:de
    rtl: false
  - type: Message
    id: urn:l10n:message:order-confirmation-title:en
    messageMeta: urn:l10n:message-meta:order-confirmation-title
    locale: urn:l10n:locale:en
    messageValue: Order ${orderNumber} confirmed
  - type: Message
    id: urn:l10n:message:order-confirmation-title:de
    messageMeta: urn:l10n:message-meta:order-confirmation-title
    locale: urn:l10n:locale:de
    messageValue: Bestellung ${orderNumber} bestaetigt
