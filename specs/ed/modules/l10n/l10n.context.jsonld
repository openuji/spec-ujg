{
  "@context": {
    "@version": 1.1,
    "ujgl10n": "https://ujg.specs.openuji.org/ed/ns/l10n#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Locale": "ujgl10n:Locale",
    "MessageMeta": "ujgl10n:MessageMeta",
    "Message": "ujgl10n:Message",
    "copy": {
      "@id": "ujgl10n:copy",
      "@type": "@id"
    },
    "localeCode": {
      "@id": "ujgl10n:localeCode",
      "@type": "xsd:language"
    },
    "argumentNames": {
      "@id": "ujgl10n:argumentNames",
      "@container": "@set"
    },
    "defaultLocale": {
      "@id": "ujgl10n:defaultLocale",
      "@type": "@id"
    },
    "fallbackLocales": {
      "@id": "ujgl10n:fallbackLocales",
      "@type": "@id",
      "@container": "@set"
    },
    "rtl": "ujgl10n:rtl",
    "messageMeta": {
      "@id": "ujgl10n:messageMeta",
      "@type": "@id"
    },
    "locale": {
      "@id": "ujgl10n:locale",
      "@type": "@id"
    },
    "messageValue": "ujgl10n:messageValue",
    "targetLocale": {
      "@id": "ujgl10n:targetLocale",
      "@type": "@id"
    }
  }
}
