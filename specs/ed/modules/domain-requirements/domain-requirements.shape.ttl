    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujgdomainrequirements:stateRef ;
    sh:maxCount 0 ;
  ] ;

  sh:property [
    sh:path ujgdomainrequirements:effectRef ;
    sh:maxCount 0 ;
  ] ;

  sh:property [
    sh:path ujgdomainrequirements:entryBindingRef ;
    sh:maxCount 0 ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ConditionDomainRequirement MUST NOT use another concrete Domain Requirements subclass." ;
    sh:select """
      SELECT $this
      WHERE {
        FILTER (
          EXISTS { $this a ujgdomainrequirements:StateDomainRequirement . }
          || EXISTS { $this a ujgdomainrequirements:EffectDomainRequirement . }
          || EXISTS { $this a ujgdomainrequirements:EntryBindingDomainRequirement . }
        )
      }
    """ ;
  ] .

