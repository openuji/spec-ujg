@prefix ujgdomainrequirements: <https://ujg.specs.openuji.org/ed/ns/domain-requirements#> .
@prefix ujgdomainrequirementsshape: <https://ujg.specs.openuji.org/ed/ns/domain-requirements.shape#> .
@prefix ujggraph: <https://ujg.specs.openuji.org/ed/ns/graph#> .
@prefix ujgcond: <https://ujg.specs.openuji.org/ed/ns/condition#> .
@prefix ujgeffect: <https://ujg.specs.openuji.org/ed/ns/effect#> .
@prefix ujgentrybinding: <https://ujg.specs.openuji.org/ed/ns/entry-binding#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ujgdomainrequirementsshape:DomainRequirementShape a sh:NodeShape ;
  sh:targetClass ujgdomainrequirements:DomainRequirement ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujgdomainrequirements:requirement ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "DomainRequirement MUST NOT be used as the sole concrete requirement type." ;
    sh:select """
      SELECT $this
      WHERE {
        FILTER (
          NOT EXISTS { $this a ujgdomainrequirements:StateDomainRequirement . }
          && NOT EXISTS { $this a ujgdomainrequirements:ConditionDomainRequirement . }
          && NOT EXISTS { $this a ujgdomainrequirements:EffectDomainRequirement . }
          && NOT EXISTS { $this a ujgdomainrequirements:EntryBindingDomainRequirement . }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A Domain Requirement MUST use at most one concrete Domain Requirements subclass." ;
    sh:select """
      SELECT $this
      WHERE {
        {
          SELECT $this (COUNT(?type) AS ?typeCount)
          WHERE {
            VALUES ?type {
              ujgdomainrequirements:StateDomainRequirement
              ujgdomainrequirements:ConditionDomainRequirement
              ujgdomainrequirements:EffectDomainRequirement
              ujgdomainrequirements:EntryBindingDomainRequirement
            }
            $this a ?type .
          }
          GROUP BY $this
        }
        FILTER (?typeCount > 1)
      }
    """ ;
  ] .

ujgdomainrequirementsshape:StateDomainRequirementShape a sh:NodeShape ;
  sh:targetClass ujgdomainrequirements:StateDomainRequirement ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujgdomainrequirements:requirement ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujgdomainrequirements:stateRef ;
    sh:class ujggraph:State ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujgdomainrequirements:conditionRef ;
    sh:maxCount 0 ;
  ] ;

  sh:property [
    sh:path ujgdomainrequirements:effectRef ;
    sh:maxCount 0 ;
  ] ;

  sh:property [
    sh:path ujgdomainrequirements:entryBindingRef ;
    sh:maxCount 0 ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "StateDomainRequirement MUST NOT use another concrete Domain Requirements subclass." ;
    sh:select """
      SELECT $this
      WHERE {
        FILTER (
          EXISTS { $this a ujgdomainrequirements:ConditionDomainRequirement . }
          || EXISTS { $this a ujgdomainrequirements:EffectDomainRequirement . }
          || EXISTS { $this a ujgdomainrequirements:EntryBindingDomainRequirement . }
        )
      }
    """ ;
  ] .

