{
  "@context": {
    "@version": 1.1,
    "ujgds": "https://ujg.specs.openuji.org/ed/ns/design-system#",
    "Theme": "ujgds:Theme",
    "TokenSource": "ujgds:TokenSource",
    "Component": "ujgds:Component",
    "Template": "ujgds:Template",
    "Slot": "ujgds:Slot",
    "SurfaceMaterialization": "ujgds:SurfaceMaterialization",
    "materializedSurface": {
      "@id": "ujgds:materializedSurface",
      "@type": "@id"
    },
    "SlotBinding": "ujgds:SlotBinding",
    "tokenSources": {
      "@id": "ujgds:tokenSources",
      "@type": "@id",
      "@container": "@set"
    },
    "source": {
      "@id": "ujgds:source",
      "@type": "@id"
    },
    "component": {
      "@id": "ujgds:component",
      "@type": "@id"
    },
    "template": {
      "@id": "ujgds:template",
      "@type": "@id"
    },
    "slotBindings": {
      "@id": "ujgds:slotBindings",
      "@type": "@id",
      "@container": "@set"
    },
    "slots": {
      "@id": "ujgds:slots",
      "@type": "@id",
      "@container": "@set"
    },
    "slot": {
      "@id": "ujgds:slot",
      "@type": "@id"
    },
    "targetSurface": {
      "@id": "ujgds:targetSurface",
      "@type": "@id"
    }
  }
}
