    },
    "instanceKeyFeature": {
      "@id": "ujgobservability:instanceKeyFeature",
      "@type": "@id"
    },
    "role": "ujgobservability:role",
    "accessibleName": {
      "@id": "ujgobservability:accessibleName",
      "@type": "@id"
    },
    "accessibleDescription": {
      "@id": "ujgobservability:accessibleDescription",
      "@type": "@id"
    },
    "accessibleFeatures": {
      "@id": "ujgobservability:accessibleFeatures",
      "@type": "@id",
      "@container": "@set"
    },
    "accessibleRelations": {
      "@id": "ujgobservability:accessibleRelations",
      "@type": "@id",
      "@container": "@set"
    },
    "contextLocators": {
      "@id": "ujgobservability:contextLocators",
      "@type": "@id",
      "@container": "@set"
    },
    "accessibleFeatureName": "ujgobservability:accessibleFeatureName",
