    },
    "requiredInputModalityProfiles": {
      "@id": "ujgobservability:requiredInputModalityProfiles",
      "@type": "@id",
      "@container": "@set"
    },
    "inputModalities": {
      "@id": "ujgobservability:inputModalities",
      "@type": "@id",
      "@container": "@set"
    },
    "locators": {
      "@id": "ujgobservability:locators",
      "@type": "@id",
      "@container": "@set"
    },
    "surfaceInstanceResolver": {
      "@id": "ujgobservability:surfaceInstanceResolver",
      "@type": "@id"
    },
    "expectedMatchCount": {
      "@id": "ujgobservability:expectedMatchCount",
