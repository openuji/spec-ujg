@prefix ujg: <https://ujg.specs.openuji.org/ed/ns/core#> .
@prefix ujgmetrics: <https://ujg.specs.openuji.org/ed/ns/metrics#> .
@prefix ujgmapping: <https://ujg.specs.openuji.org/ed/ns/mapping#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ujgmetricsshape: <https://ujg.specs.openuji.org/ed/ns/metrics.shape#> .

ujgmetricsshape:MetricObservationShape a sh:NodeShape ;
  sh:targetClass ujgmetrics:MetricObservation ; sh:nodeKind sh:IRI ;
  sh:property [ sh:path ujgmetrics:metricSubject ; sh:maxCount 1 ; sh:minCount 1 ; sh:nodeKind sh:IRI ; ] ;
  sh:property [ sh:path ujgmetrics:sourceMapping ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; ] ;
  sh:property [ sh:path ujgmetrics:metricKey ; sh:maxCount 1 ; sh:minCount 1 ; sh:datatype xsd:string ; ] ;
  sh:property [ sh:path ujgmetrics:metricUnit ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
  sh:property [ sh:path ujgmetrics:aggregationMethod ; sh:maxCount 1 ; sh:datatype xsd:string ; ] ;
  sh:property [ sh:path ujgmetrics:metricValue ; sh:maxCount 1 ; sh:minCount 1 ; sh:or ( [ sh:datatype xsd:integer ] [ sh:datatype xsd:decimal ] [ sh:datatype xsd:double ] [ sh:datatype xsd:boolean ] ) ; ] ;
  sh:property [ sh:path ujgmetrics:numeratorCount ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; ] ;
  sh:property [ sh:path ujgmetrics:denominatorCount ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Count metrics require non-negative integer values; rate metrics require ratio values between zero and one." ;
    sh:select """
      SELECT $this WHERE {
        $this ujgmetrics:metricKey ?key ; ujgmetrics:metricValue ?value .
        OPTIONAL { $this ujgmetrics:metricUnit ?unit }
        FILTER (
          ((?unit = "count" || ?key IN ("stepCount", "movementCount", "explainedMovementCount", "unexplainedMovementCount", "stateVisitCount", "transitionTraversalCount", "outgoingTraversalCount", "boundaryEntryCount", "boundaryExitCount", "boundaryCrossingCount")) &&
            (!isNumeric(?value) || ?value < 0 || DATATYPE(?value) NOT IN (xsd:integer, xsd:nonNegativeInteger))) ||
          ((?unit = "ratio" || ?key = "unexplainedMovementRate") &&
            (!isNumeric(?value) || ?value < 0 || ?value > 1 || !BOUND(?unit) || ?unit != "ratio"))
        )
      }
    """ ;
  ] .
