@prefix ujg: <https://ujg.specs.openuji.org/ed/ns/core#> .
@prefix ujgmetrics: <https://ujg.specs.openuji.org/ed/ns/metrics#> .
@prefix ujgmapping: <https://ujg.specs.openuji.org/ed/ns/mapping#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ujg.specs.openuji.org/ed/ns/metrics#> a owl:Ontology .
ujgmetrics:MetricObservation a owl:Class ; rdfs:subClassOf ujg:Node .
ujgmetrics:metricSubject a owl:ObjectProperty ; rdfs:domain ujgmetrics:MetricObservation ; rdfs:range ujg:Node .
ujgmetrics:sourceMapping a owl:ObjectProperty ; rdfs:domain ujgmetrics:MetricObservation ; rdfs:range ujgmapping:JourneyMapping .
ujgmetrics:metricKey a owl:DatatypeProperty ; rdfs:domain ujgmetrics:MetricObservation ; rdfs:range xsd:string .
ujgmetrics:metricUnit a owl:DatatypeProperty ; rdfs:domain ujgmetrics:MetricObservation ; rdfs:range xsd:string .
ujgmetrics:aggregationMethod a owl:DatatypeProperty ; rdfs:domain ujgmetrics:MetricObservation ; rdfs:range xsd:string .
ujgmetrics:metricValue a owl:DatatypeProperty ; rdfs:domain ujgmetrics:MetricObservation ; rdfs:range rdfs:Literal .
ujgmetrics:numeratorCount a owl:DatatypeProperty ; rdfs:domain ujgmetrics:MetricObservation ; rdfs:range xsd:nonNegativeInteger .
ujgmetrics:denominatorCount a owl:DatatypeProperty ; rdfs:domain ujgmetrics:MetricObservation ; rdfs:range xsd:nonNegativeInteger .
