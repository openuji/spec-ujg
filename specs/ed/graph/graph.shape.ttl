@prefix ujggraph: <https://ujg.specs.openuji.org/ed/ns/graph#> .
@prefix ujg: <https://ujg.specs.openuji.org/ed/ns/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ujggraphshape: <https://ujg.specs.openuji.org/ed/ns/graph.shape#> .


ujggraphshape:StateLikeShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:or (
    [ sh:class ujggraph:State ]
    [ sh:class ujggraph:CompositeState ]
  ) .

ujggraphshape:LocalVertexLikeShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:or (
    [ sh:class ujggraph:State ]
    [ sh:class ujggraph:CompositeState ]
    [ sh:class ujggraph:JourneyExit ]
  ) .

ujggraphshape:EntryTransitionLikeShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:or (
    [ sh:class ujggraph:OutgoingTransition ]
    [ sh:class ujggraph:InvokingTransition ]
  ) .

ujggraphshape:CommandShape a sh:NodeShape ;
  sh:targetClass ujggraph:Command ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:tags ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path ujggraph:from ;
    sh:maxCount 0 ;
    sh:message "A Command must not declare from; use command from a Transition, OutgoingTransition, or InvokingTransition." ;
  ] ;

  sh:property [
    sh:path ujggraph:to ;
    sh:maxCount 0 ;
    sh:message "A Command must not declare to; use command from a Transition, OutgoingTransition, or InvokingTransition." ;
  ] ;

  sh:property [
    sh:path ujggraph:toEntry ;
    sh:maxCount 0 ;
    sh:message "A Command must not declare toEntry." ;
  ] ;

  sh:property [
    sh:path ujggraph:fromExit ;
    sh:maxCount 0 ;
    sh:message "A Command must not declare fromExit." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "A Command must not declare subjourneys." ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "A Command must not declare entryTransitions." ;
  ] .

ujggraphshape:JourneyShape a sh:NodeShape ;
  sh:targetClass ujggraph:Journey ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:defaultEntry ;
    sh:maxCount 1 ;
    sh:class ujggraph:JourneyEntry ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path ujggraph:entries ;
    sh:minCount 1 ;
    sh:class ujggraph:JourneyEntry ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path ujggraph:states ;
    sh:minCount 1 ;
    sh:node ujggraphshape:StateLikeShape ;
  ] ;

  sh:property [
    sh:path ujggraph:transitions ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:class ujggraph:Transition ]
      [ sh:class ujggraph:AdjacentTransition ]
    ) ;
    sh:message "Each transitions value must reference a Transition or an AdjacentTransition." ;
  ] ;

  sh:property [
    sh:path ujggraph:exits ;
    sh:class ujggraph:JourneyExit ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "A Journey must not declare entryTransitions. List entry transitions on the States that offer them." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "A Journey must not declare subjourneys; only CompositeState declares child Journey references." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A journey's defaultEntry must be listed in the same journey's entries." ;
    sh:select """
      SELECT $this ?entry
      WHERE {
        $this ujggraph:defaultEntry ?entry .

        FILTER (NOT EXISTS {
          $this ujggraph:entries ?entry .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A JourneyEntry listed in entries must have a state listed in the same journey's states." ;
    sh:select """
      SELECT $this ?entry ?state
      WHERE {
        $this ujggraph:entries ?entry .
        ?entry ujggraph:state ?state .

        FILTER (NOT EXISTS {
          $this ujggraph:states ?state .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A JourneyEntry must be listed in the entries of exactly one journey." ;
    sh:select """
      SELECT $this ?entry
      WHERE {
        $this ujggraph:entries ?entry .

        FILTER (
          EXISTS {
            ?otherJourney a ujggraph:Journey ;
                          ujggraph:entries ?entry .
            FILTER ($this != ?otherJourney)
          }
          || NOT EXISTS {
            ?declaringJourney a ujggraph:Journey ;
                              ujggraph:entries ?entry .
          }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A transition in transitions has a from value that is not listed in this journey's states." ;
    sh:select """
      SELECT $this ?transition ?from
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:from ?from .

        FILTER (NOT EXISTS {
          $this ujggraph:states ?from .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A transition in transitions has a from value that references a JourneyExit." ;
    sh:select """
      SELECT $this ?transition ?from
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:from ?from .
        ?from a ujggraph:JourneyExit .
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A transition in transitions has a to value that is not listed in this journey's states or exits." ;
    sh:select """
      SELECT $this ?transition ?to
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:to ?to .

        FILTER (
          NOT EXISTS { $this ujggraph:states ?to . }
          && NOT EXISTS { $this ujggraph:exits ?to . }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A JourneyExit must be listed in the exits of exactly one journey." ;
    sh:select """
      SELECT $this ?exit
      WHERE {
        $this ujggraph:exits ?exit .

        FILTER (
          EXISTS {
            ?otherJourney ujggraph:exits ?exit .
            FILTER ($this != ?otherJourney)
          }
          || NOT EXISTS {
            ?declaringJourney ujggraph:exits ?exit .
          }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A JourneyExit used as Transition.to must be listed in the same enclosing journey's exits." ;
    sh:select """
      SELECT $this ?transition ?exit
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:to ?exit .
        ?exit a ujggraph:JourneyExit .

        FILTER (NOT EXISTS {
          $this ujggraph:exits ?exit .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A transition with fromExit must have a from value listed in the enclosing journey's states." ;
    sh:select """
      SELECT $this ?transition ?from
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:fromExit ?exit ;
                    ujggraph:from ?from .

        FILTER (NOT EXISTS {
          $this ujggraph:states ?from .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A transition with toEntry must have a to value listed in the enclosing journey's states." ;
    sh:select """
      SELECT $this ?transition ?to
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:toEntry ?entry ;
                    ujggraph:to ?to .

        FILTER (NOT EXISTS {
          $this ujggraph:states ?to .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A transition with toEntry must have a to value that references a CompositeState." ;
    sh:select """
      SELECT $this ?transition ?to
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:toEntry ?entry ;
                    ujggraph:to ?to .

        FILTER (NOT EXISTS {
          ?to a ujggraph:CompositeState .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The toEntry of a parent transition must be listed in the entries of exactly one Journey referenced by the target CompositeState's subjourneys." ;
    sh:select """
      SELECT $this ?transition ?to ?entry
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:toEntry ?entry ;
                    ujggraph:to ?to .

        FILTER (NOT EXISTS {
          ?to ujggraph:subjourneys ?childJourney .
          ?childJourney ujggraph:entries ?entry .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The toEntry of a parent transition must not be listed in more than one Journey referenced by the target CompositeState's subjourneys." ;
    sh:select """
      SELECT $this ?transition ?to ?entry
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:toEntry ?entry ;
                    ujggraph:to ?to .
        ?to ujggraph:subjourneys ?childJourneyA, ?childJourneyB .
        ?childJourneyA ujggraph:entries ?entry .
        ?childJourneyB ujggraph:entries ?entry .

        FILTER (?childJourneyA != ?childJourneyB)
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A transition with fromExit must have a from value that references a CompositeState." ;
    sh:select """
      SELECT $this ?transition ?from
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:fromExit ?exit ;
                    ujggraph:from ?from .

        FILTER (NOT EXISTS {
          ?from a ujggraph:CompositeState .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The fromExit of a parent transition must be listed in the exits of exactly one Journey referenced by the source CompositeState's subjourneys." ;
    sh:select """
      SELECT $this ?transition ?from ?exit
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:fromExit ?exit ;
                    ujggraph:from ?from .

        FILTER (NOT EXISTS {
          ?from ujggraph:subjourneys ?childJourney .
          ?childJourney ujggraph:exits ?exit .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The fromExit of a parent transition must not be listed in more than one Journey referenced by the source CompositeState's subjourneys." ;
    sh:select """
      SELECT $this ?transition ?from ?exit
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:fromExit ?exit ;
                    ujggraph:from ?from .
        ?from ujggraph:subjourneys ?childJourneyA, ?childJourneyB .
        ?childJourneyA ujggraph:exits ?exit .
        ?childJourneyB ujggraph:exits ?exit .

        FILTER (?childJourneyA != ?childJourneyB)
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A transition with fromExit must have a to value listed in the enclosing journey's states or exits." ;
    sh:select """
      SELECT $this ?transition ?to
      WHERE {
        $this ujggraph:transitions ?transition .
        ?transition ujggraph:fromExit ?exit ;
                    ujggraph:to ?to .

        FILTER (
          NOT EXISTS { $this ujggraph:states ?to . }
          && NOT EXISTS { $this ujggraph:exits ?to . }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A journey must not contain more than one transition with the same from value and the same fromExit value." ;
    sh:select """
      SELECT $this ?from ?exit ?transition ?otherTransition
      WHERE {
        $this ujggraph:transitions ?transition, ?otherTransition .
        ?transition ujggraph:from ?from ;
                    ujggraph:fromExit ?exit .
        ?otherTransition ujggraph:from ?from ;
                         ujggraph:fromExit ?exit .
        FILTER (?transition != ?otherTransition)
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Warning ;
    sh:message "A state in Journey.states is not an entry state or a local transition endpoint. Verify that it belongs to the journey's experiential local topology and is not only a linked destination." ;
    sh:select """
      SELECT $this ?state
      WHERE {
        $this ujggraph:states ?state .

        FILTER (NOT EXISTS {
          $this ujggraph:entries ?entry .
          ?entry ujggraph:state ?state .
        })

        FILTER (NOT EXISTS {
          $this ujggraph:transitions ?transition .
          ?transition ujggraph:from ?state .
        })

        FILTER (NOT EXISTS {
          $this ujggraph:transitions ?transition .
          ?transition ujggraph:to ?state .
        })
      }
    """ ;
  ] .

ujggraphshape:JourneyEntryShape a sh:NodeShape ;
  sh:targetClass ujggraph:JourneyEntry ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:state ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node ujggraphshape:StateLikeShape ;
  ] ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:tags ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntry must not declare subjourneys." ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntry must not declare entryTransitions." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A JourneyEntry must be listed in the entries of exactly one journey." ;
    sh:select """
      SELECT $this
      WHERE {
        FILTER (
          NOT EXISTS {
            ?journey a ujggraph:Journey ;
                     ujggraph:entries $this .
          }
          || EXISTS {
            ?journeyA a ujggraph:Journey ;
                      ujggraph:entries $this .
            ?journeyB a ujggraph:Journey ;
                      ujggraph:entries $this .
            FILTER (?journeyA != ?journeyB)
          }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A JourneyEntry must not be used as the from or to value of a Transition or AdjacentTransition." ;
    sh:select """
      SELECT $this ?transition
      WHERE {
        {
          ?transition ujggraph:from $this .
        }
        UNION
        {
          ?transition ujggraph:to $this .
        }
      }
    """ ;
  ] .

ujggraphshape:JourneyEntryIndexShape a sh:NodeShape ;
  sh:targetClass ujggraph:JourneyEntryIndex ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:entries ;
    sh:minCount 1 ;
    sh:class ujggraph:JourneyEntry ;
    sh:nodeKind sh:IRI ;
  ] ;

  sh:property [
    sh:path ujggraph:transitions ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare transitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:exits ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare exits." ;
  ] ;

  sh:property [
    sh:path ujggraph:from ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare from." ;
  ] ;

  sh:property [
    sh:path ujggraph:to ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare to." ;
  ] ;

  sh:property [
    sh:path ujggraph:fromExit ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare fromExit." ;
  ] ;

  sh:property [
    sh:path ujggraph:toEntry ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare toEntry." ;
  ] ;

  sh:property [
    sh:path ujggraph:defaultEntry ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare defaultEntry." ;
  ] ;

  sh:property [
    sh:path ujggraph:states ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare states." ;
  ] ;

  sh:property [
    sh:path ujggraph:state ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare state." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare subjourneys." ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "A JourneyEntryIndex must not declare entryTransitions." ;
  ] .

ujggraphshape:StateShape a sh:NodeShape ;
  sh:targetClass ujggraph:State ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:tags ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:node ujggraphshape:EntryTransitionLikeShape ;
    sh:nodeKind sh:IRI ;
    sh:message "Each entryTransitions value must reference an OutgoingTransition or an InvokingTransition." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A State must not be listed in the states of more than one journey." ;
    sh:select """
      SELECT $this
      WHERE {
        ?journeyA ujggraph:states $this .
        ?journeyB ujggraph:states $this .
        FILTER (?journeyA != ?journeyB)
      }
    """ ;
  ] .

ujggraphshape:CompositeStateShape a sh:NodeShape ;
  sh:targetClass ujggraph:CompositeState ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:tags ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path ujggraph:states ;
    sh:maxCount 0 ;
    sh:message "A CompositeState must not use states; use subjourneys to reference one or more child Journeys." ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "A CompositeState must not declare entryTransitions. Entry transitions are listed by the States that offer them." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:class ujggraph:Journey ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A CompositeState must not also be typed State or JourneyExit." ;
    sh:select """
      SELECT $this
      WHERE {
        { $this a ujggraph:State . }
        UNION
        { $this a ujggraph:JourneyExit . }
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A CompositeState must not be listed in the states of more than one journey." ;
    sh:select """
      SELECT $this
      WHERE {
        ?journeyA ujggraph:states $this .
        ?journeyB ujggraph:states $this .
        FILTER (?journeyA != ?journeyB)
      }
    """ ;
  ] .

ujggraphshape:TransitionShape a sh:NodeShape ;
  sh:targetClass ujggraph:Transition ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:from ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node ujggraphshape:StateLikeShape ;
  ] ;

  sh:property [
    sh:path ujggraph:to ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node ujggraphshape:LocalVertexLikeShape ;
  ] ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:fromExit ;
    sh:class ujggraph:JourneyExit ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:toEntry ;
    sh:class ujggraph:JourneyEntry ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:command ;
    sh:class ujggraph:Command ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "A Transition must not declare entryTransitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "A Transition must not declare subjourneys." ;
  ] .

ujggraphshape:AdjacentTransitionShape a sh:NodeShape ;
  sh:targetClass ujggraph:AdjacentTransition ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:from ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node ujggraphshape:StateLikeShape ;
    sh:message "An AdjacentTransition must declare exactly one from value that references a State or CompositeState." ;
  ] ;

  sh:property [
    sh:path ujggraph:to ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node ujggraphshape:StateLikeShape ;
    sh:message "An AdjacentTransition must declare exactly one to value that references a State or CompositeState, never a JourneyExit." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An AdjacentTransition must connect two different vertices; from and to must differ unless a StateCollection lists it in memberTransitions, where both are the member State." ;
    sh:select """
      SELECT $this ?vertex
      WHERE {
        $this ujggraph:from ?vertex ;
              ujggraph:to ?vertex .

        FILTER (NOT EXISTS {
          ?collection a ujggraph:StateCollection ;
                      ujggraph:memberTransitions $this .
        })
      }
    """ ;
  ] ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:command ;
    sh:maxCount 0 ;
    sh:message "An AdjacentTransition must not declare command. Model a command-driven movement as a Transition with command." ;
  ] ;

  sh:property [
    sh:path ujggraph:toEntry ;
    sh:maxCount 0 ;
    sh:message "An AdjacentTransition must not declare toEntry." ;
  ] ;

  sh:property [
    sh:path ujggraph:fromExit ;
    sh:maxCount 0 ;
    sh:message "An AdjacentTransition must not declare fromExit." ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "An AdjacentTransition must not declare entryTransitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "An AdjacentTransition must not declare subjourneys." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An AdjacentTransition must not also be typed Transition, OutgoingTransition, or InvokingTransition." ;
    sh:select """
      SELECT $this
      WHERE {
        { $this a ujggraph:Transition . }
        UNION
        { $this a ujggraph:OutgoingTransition . }
        UNION
        { $this a ujggraph:InvokingTransition . }
      }
    """ ;
  ] .

ujggraphshape:AdjacentTransitionDuplicateShape a sh:NodeShape ;
  sh:targetClass ujggraph:AdjacentTransition ;
  sh:severity sh:Warning ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A Transition without command, toEntry, or fromExit connects the same two vertices as this AdjacentTransition, or moves between the same StateCollection's members. Unless it carries a guard or an effect, it duplicates one direction of the adjacency." ;
    sh:select """
      SELECT $this ?transition
      WHERE {
        $this ujggraph:from ?a ;
              ujggraph:to ?b .
        ?transition a ujggraph:Transition .
        {
          ?transition ujggraph:from ?a ;
                      ujggraph:to ?b .
        }
        UNION
        {
          ?transition ujggraph:from ?b ;
                      ujggraph:to ?a .
        }
        FILTER (?transition != $this)
        FILTER (NOT EXISTS { ?transition ujggraph:command ?command . })
        FILTER (NOT EXISTS { ?transition ujggraph:toEntry ?entry . })
        FILTER (NOT EXISTS { ?transition ujggraph:fromExit ?exit . })
        FILTER (
          EXISTS {
            ?collection ujggraph:memberTransitions $this, ?transition .
          }
          || (
            NOT EXISTS { ?collectionA ujggraph:memberTransitions $this . }
            && NOT EXISTS { ?collectionB ujggraph:memberTransitions ?transition . }
          )
        )
      }
    """ ;
  ] .

ujggraphshape:JourneyExitShape a sh:NodeShape ;
  sh:targetClass ujggraph:JourneyExit ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:tags ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "A JourneyExit must not declare entryTransitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "A JourneyExit must not declare subjourneys." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A JourneyExit must not also be typed State or CompositeState." ;
    sh:select """
      SELECT $this
      WHERE {
        { $this a ujggraph:State . }
        UNION
        { $this a ujggraph:CompositeState . }
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A JourneyExit must be listed in the exits of exactly one journey." ;
    sh:select """
      SELECT $this
      WHERE {
        FILTER (
          NOT EXISTS { ?journey ujggraph:exits $this . }
          || EXISTS {
            ?journeyA ujggraph:exits $this .
            ?journeyB ujggraph:exits $this .
            FILTER (?journeyA != ?journeyB)
          }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A JourneyExit must not be used as the from value of a Transition or AdjacentTransition." ;
    sh:select """
      SELECT $this ?transition
      WHERE {
        ?transition ujggraph:from $this .
      }
    """ ;
  ] .

ujggraphshape:OutgoingTransitionShape a sh:NodeShape ;
  sh:targetClass ujggraph:OutgoingTransition ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:to ;
    sh:maxCount 0 ;
    sh:message "An OutgoingTransition must not declare to; target a JourneyEntry with toEntry or select one through entrySelector." ;
  ] ;

  sh:property [
    sh:path ujggraph:toEntry ;
    sh:class ujggraph:JourneyEntry ;
    sh:node ujggraphshape:JourneyEntryShape ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:entrySelector ;
    sh:class ujggraph:EntrySelector ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An OutgoingTransition must declare exactly one of toEntry or entrySelector." ;
    sh:select """
      SELECT $this
      WHERE {
        FILTER (
          (
            EXISTS { $this ujggraph:toEntry ?entry . }
            && EXISTS { $this ujggraph:entrySelector ?selector . }
          )
          || (
            NOT EXISTS { $this ujggraph:toEntry ?entry . }
            && NOT EXISTS { $this ujggraph:entrySelector ?selector . }
          )
        )
      }
    """ ;
  ] ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:command ;
    sh:class ujggraph:Command ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:from ;
    sh:maxCount 0 ;
    sh:message "An OutgoingTransition must not declare from. Its sources are the States that list it in entryTransitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:fromExit ;
    sh:maxCount 0 ;
    sh:message "An OutgoingTransition must not declare fromExit." ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "An OutgoingTransition must not declare entryTransitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "An OutgoingTransition must not declare subjourneys." ;
  ] .

ujggraphshape:InvokingTransitionShape a sh:NodeShape ;
  sh:targetClass ujggraph:InvokingTransition ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:to ;
    sh:maxCount 0 ;
    sh:message "An InvokingTransition must not declare to; target a JourneyEntry with toEntry or select one through entrySelector." ;
  ] ;

  sh:property [
    sh:path ujggraph:toEntry ;
    sh:class ujggraph:JourneyEntry ;
    sh:node ujggraphshape:JourneyEntryShape ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:entrySelector ;
    sh:class ujggraph:EntrySelector ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An InvokingTransition must declare exactly one of toEntry or entrySelector." ;
    sh:select """
      SELECT $this
      WHERE {
        FILTER (
          (
            EXISTS { $this ujggraph:toEntry ?entry . }
            && EXISTS { $this ujggraph:entrySelector ?selector . }
          )
          || (
            NOT EXISTS { $this ujggraph:toEntry ?entry . }
            && NOT EXISTS { $this ujggraph:entrySelector ?selector . }
          )
        )
      }
    """ ;
  ] ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:command ;
    sh:class ujggraph:Command ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:from ;
    sh:maxCount 0 ;
    sh:message "An InvokingTransition must not declare from. Its sources are the States that list it in entryTransitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:fromExit ;
    sh:maxCount 0 ;
    sh:message "An InvokingTransition must not declare fromExit." ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "An InvokingTransition must not declare entryTransitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "An InvokingTransition must not declare subjourneys." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An InvokingTransition must not also be typed OutgoingTransition." ;
    sh:select """
      SELECT $this
      WHERE {
        $this a ujggraph:OutgoingTransition .
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The Journey that owns an InvokingTransition's toEntry must declare at least one exits value." ;
    sh:select """
      SELECT $this ?entry ?journey
      WHERE {
        $this ujggraph:toEntry ?entry .
        ?journey a ujggraph:Journey ;
                 ujggraph:entries ?entry .

        FILTER (NOT EXISTS {
          ?journey ujggraph:exits ?exit .
        })
      }
    """ ;
  ];

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Each candidate Journey of an InvokingTransition's EntrySelector must declare at least one exits value." ;
    sh:select """
      SELECT $this ?selector ?journey
      WHERE {
        $this ujggraph:entrySelector ?selector .
        ?selector ujggraph:candidateJourneys ?journey .

        FILTER (NOT EXISTS {
          ?journey ujggraph:exits ?exit .
        })
      }
    """ ;
  ] .

ujggraphshape:StateCollectionShape a sh:NodeShape ;
  sh:targetClass ujggraph:StateCollection ;
  sh:nodeKind sh:IRI ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A StateCollection and its member State must have effective membership in one source document." ;
    sh:select """
      SELECT $this WHERE {
        $this ujggraph:memberState ?state .
        FILTER NOT EXISTS {
          GRAPH ?sourceScope {
            ?document ujg:members $this ; ujg:members ?state .
          }
        }
      }
    """ ;
  ] ;

  sh:property [
    sh:path ujggraph:memberState ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:node ujggraphshape:StateLikeShape ;
    sh:message "A StateCollection must declare exactly one memberState that references a State or CompositeState." ;
  ] ;

  sh:property [
    sh:path ujggraph:memberTransitions ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:class ujggraph:Transition ]
      [ sh:class ujggraph:AdjacentTransition ]
    ) ;
    sh:message "A StateCollection must declare at least one memberTransitions value, and each must reference a Transition or an AdjacentTransition." ;
  ] ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:tags ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path ujggraph:from ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare from." ;
  ] ;

  sh:property [
    sh:path ujggraph:to ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare to." ;
  ] ;

  sh:property [
    sh:path ujggraph:toEntry ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare toEntry." ;
  ] ;

  sh:property [
    sh:path ujggraph:fromExit ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare fromExit." ;
  ] ;

  sh:property [
    sh:path ujggraph:command ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare command." ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare entryTransitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare subjourneys." ;
  ] ;

  sh:property [
    sh:path ujggraph:transitions ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare transitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:states ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare states." ;
  ] ;

  sh:property [
    sh:path ujggraph:state ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare state." ;
  ] ;

  sh:property [
    sh:path ujggraph:entries ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare entries." ;
  ] ;

  sh:property [
    sh:path ujggraph:exits ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare exits." ;
  ] ;

  sh:property [
    sh:path ujggraph:defaultEntry ;
    sh:maxCount 0 ;
    sh:message "A StateCollection must not declare defaultEntry." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A StateCollection must not also be typed Journey, JourneyEntry, JourneyEntryIndex, State, CompositeState, Transition, AdjacentTransition, OutgoingTransition, InvokingTransition, Command, or JourneyExit." ;
    sh:select """
      SELECT $this
      WHERE {
        { $this a ujggraph:Journey . }
        UNION
        { $this a ujggraph:JourneyEntry . }
        UNION
        { $this a ujggraph:JourneyEntryIndex . }
        UNION
        { $this a ujggraph:State . }
        UNION
        { $this a ujggraph:CompositeState . }
        UNION
        { $this a ujggraph:Transition . }
        UNION
        { $this a ujggraph:AdjacentTransition . }
        UNION
        { $this a ujggraph:OutgoingTransition . }
        UNION
        { $this a ujggraph:InvokingTransition . }
        UNION
        { $this a ujggraph:Command . }
        UNION
        { $this a ujggraph:JourneyExit . }
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The member State of a StateCollection must be listed in the states of a Journey." ;
    sh:select """
      SELECT $this ?state
      WHERE {
        $this ujggraph:memberState ?state .

        FILTER (NOT EXISTS {
          ?journey ujggraph:states ?state .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A State or CompositeState must not be the member State of more than one StateCollection." ;
    sh:select """
      SELECT $this ?state ?otherCollection
      WHERE {
        $this ujggraph:memberState ?state .
        ?otherCollection a ujggraph:StateCollection ;
                         ujggraph:memberState ?state .
        FILTER (?otherCollection != $this)
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Each member transition of a StateCollection must have the member State as both its from and its to value." ;
    sh:select """
      SELECT $this ?transition
      WHERE {
        $this ujggraph:memberState ?state ;
              ujggraph:memberTransitions ?transition .

        FILTER (
          NOT EXISTS { ?transition ujggraph:from ?state . }
          || NOT EXISTS { ?transition ujggraph:to ?state . }
          || EXISTS {
            ?transition ujggraph:from ?from .
            FILTER (?from != ?state)
          }
          || EXISTS {
            ?transition ujggraph:to ?to .
            FILTER (?to != ?state)
          }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A member transition must not also be listed in a Journey's transitions." ;
    sh:select """
      SELECT $this ?transition ?journey
      WHERE {
        $this ujggraph:memberTransitions ?transition .
        ?journey ujggraph:transitions ?transition .
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A member transition must not be listed in the memberTransitions of more than one StateCollection." ;
    sh:select """
      SELECT $this ?transition ?otherCollection
      WHERE {
        $this ujggraph:memberTransitions ?transition .
        ?otherCollection a ujggraph:StateCollection ;
                         ujggraph:memberTransitions ?transition .
        FILTER (?otherCollection != $this)
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A member transition with toEntry or fromExit requires a CompositeState member State." ;
    sh:select """
      SELECT $this ?transition ?state
      WHERE {
        $this ujggraph:memberState ?state ;
              ujggraph:memberTransitions ?transition .
        { ?transition ujggraph:toEntry ?boundary . }
        UNION
        { ?transition ujggraph:fromExit ?boundary . }

        FILTER (NOT EXISTS {
          ?state a ujggraph:CompositeState .
        })
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The toEntry of a member transition must be listed in the entries of exactly one Journey referenced by the member State's subjourneys." ;
    sh:select """
      SELECT $this ?transition ?entry
      WHERE {
        $this ujggraph:memberState ?state ;
              ujggraph:memberTransitions ?transition .
        ?state a ujggraph:CompositeState .
        ?transition ujggraph:toEntry ?entry .

        FILTER (
          NOT EXISTS {
            ?state ujggraph:subjourneys ?childJourney .
            ?childJourney ujggraph:entries ?entry .
          }
          || EXISTS {
            ?state ujggraph:subjourneys ?childJourneyA, ?childJourneyB .
            ?childJourneyA ujggraph:entries ?entry .
            ?childJourneyB ujggraph:entries ?entry .
            FILTER (?childJourneyA != ?childJourneyB)
          }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The fromExit of a member transition must be listed in the exits of exactly one Journey referenced by the member State's subjourneys." ;
    sh:select """
      SELECT $this ?transition ?exit
      WHERE {
        $this ujggraph:memberState ?state ;
              ujggraph:memberTransitions ?transition .
        ?state a ujggraph:CompositeState .
        ?transition ujggraph:fromExit ?exit .

        FILTER (
          NOT EXISTS {
            ?state ujggraph:subjourneys ?childJourney .
            ?childJourney ujggraph:exits ?exit .
          }
          || EXISTS {
            ?state ujggraph:subjourneys ?childJourneyA, ?childJourneyB .
            ?childJourneyA ujggraph:exits ?exit .
            ?childJourneyB ujggraph:exits ?exit .
            FILTER (?childJourneyA != ?childJourneyB)
          }
        )
      }
    """ ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "A member transition with fromExit must not share its member State and fromExit value with another member transition or with a transition in a Journey's transitions." ;
    sh:select """
      SELECT $this ?transition ?otherTransition ?exit
      WHERE {
        $this ujggraph:memberState ?state ;
              ujggraph:memberTransitions ?transition .
        ?transition ujggraph:fromExit ?exit .
        ?otherTransition ujggraph:from ?state ;
                         ujggraph:fromExit ?exit .
        FILTER (?otherTransition != ?transition)
        FILTER (
          EXISTS { $this ujggraph:memberTransitions ?otherTransition . }
          || EXISTS { ?journey ujggraph:transitions ?otherTransition . }
        )
      }
    """ ;
  ] .

ujggraphshape:MemberStateSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujggraph:memberState ;
  sh:class ujggraph:StateCollection ;
  sh:message "Only a StateCollection declares memberState." .

ujggraphshape:MemberTransitionSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujggraph:memberTransitions ;
  sh:class ujggraph:StateCollection ;
  sh:message "Only a StateCollection declares memberTransitions." .

ujggraphshape:EntrySelectorShape a sh:NodeShape ;
  sh:targetClass ujggraph:EntrySelector ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujggraph:candidateJourneys ;
    sh:class ujggraph:Journey ;
    sh:nodeKind sh:IRI ;
    sh:message "Each candidateJourneys value must reference a Journey." ;
  ] ;

  sh:property [
    sh:path ujggraph:label ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujggraph:tags ;
    sh:datatype xsd:string ;
  ] ;

  sh:property [
    sh:path ujggraph:from ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare from." ;
  ] ;

  sh:property [
    sh:path ujggraph:to ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare to." ;
  ] ;

  sh:property [
    sh:path ujggraph:toEntry ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare toEntry; it names no entry." ;
  ] ;

  sh:property [
    sh:path ujggraph:fromExit ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare fromExit." ;
  ] ;

  sh:property [
    sh:path ujggraph:command ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare command; declare it on the entry transition that references the selector." ;
  ] ;

  sh:property [
    sh:path ujggraph:entryTransitions ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare entryTransitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:subjourneys ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare subjourneys." ;
  ] ;

  sh:property [
    sh:path ujggraph:transitions ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare transitions." ;
  ] ;

  sh:property [
    sh:path ujggraph:states ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare states." ;
  ] ;

  sh:property [
    sh:path ujggraph:state ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare state." ;
  ] ;

  sh:property [
    sh:path ujggraph:entries ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare entries; list candidate Journeys in candidateJourneys." ;
  ] ;

  sh:property [
    sh:path ujggraph:exits ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare exits." ;
  ] ;

  sh:property [
    sh:path ujggraph:defaultEntry ;
    sh:maxCount 0 ;
    sh:message "An EntrySelector must not declare defaultEntry." ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An EntrySelector must not also be typed Journey, JourneyEntry, JourneyEntryIndex, State, CompositeState, Transition, AdjacentTransition, OutgoingTransition, InvokingTransition, Command, JourneyExit, or StateCollection." ;
    sh:select """
      SELECT $this
      WHERE {
        { $this a ujggraph:Journey . }
        UNION
        { $this a ujggraph:JourneyEntry . }
        UNION
        { $this a ujggraph:JourneyEntryIndex . }
        UNION
        { $this a ujggraph:State . }
        UNION
        { $this a ujggraph:CompositeState . }
        UNION
        { $this a ujggraph:Transition . }
        UNION
        { $this a ujggraph:AdjacentTransition . }
        UNION
        { $this a ujggraph:OutgoingTransition . }
        UNION
        { $this a ujggraph:InvokingTransition . }
        UNION
        { $this a ujggraph:Command . }
        UNION
        { $this a ujggraph:JourneyExit . }
        UNION
        { $this a ujggraph:StateCollection . }
      }
    """ ;
  ] .

ujggraphshape:EntrySelectorSubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujggraph:entrySelector ;
  sh:or (
    [ sh:class ujggraph:OutgoingTransition ]
    [ sh:class ujggraph:InvokingTransition ]
  ) ;
  sh:message "Only an OutgoingTransition or InvokingTransition declares entrySelector." .

ujggraphshape:CandidateJourneySubjectShape a sh:NodeShape ;
  sh:targetSubjectsOf ujggraph:candidateJourneys ;
  sh:class ujggraph:EntrySelector ;
  sh:message "Only an EntrySelector declares candidateJourneys." .
