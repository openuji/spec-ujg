{
  "@context": {
    "@version": 1.1,
    "ujggraph": "https://ujg.specs.openuji.org/ed/ns/graph#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "Journey": "ujggraph:Journey",
    "JourneyEntry": "ujggraph:JourneyEntry",
    "JourneyEntryIndex": "ujggraph:JourneyEntryIndex",
    "State": "ujggraph:State",
    "CompositeState": "ujggraph:CompositeState",
    "Transition": "ujggraph:Transition",
    "AdjacentTransition": "ujggraph:AdjacentTransition",
    "Command": "ujggraph:Command",
    "JourneyExit": "ujggraph:JourneyExit",
    "OutgoingTransition": "ujggraph:OutgoingTransition",
    "InvokingTransition": "ujggraph:InvokingTransition",
    "StateCollection": "ujggraph:StateCollection",
    "EntrySelector": "ujggraph:EntrySelector",
    "label": "ujggraph:label",
    "tags": {
      "@id": "ujggraph:tags",
      "@container": "@set"
    },
    "defaultEntry": {
      "@id": "ujggraph:defaultEntry",
      "@type": "@id"
    },
    "entries": {
      "@id": "ujggraph:entries",
      "@type": "@id",
      "@container": "@set"
    },
    "state": {
      "@id": "ujggraph:state",
      "@type": "@id"
    },
    "states": {
      "@id": "ujggraph:states",
      "@type": "@id",
      "@container": "@set"
    },
    "transitions": {
      "@id": "ujggraph:transitions",
      "@type": "@id",
      "@container": "@set"
    },
    "exits": {
      "@id": "ujggraph:exits",
      "@type": "@id",
      "@container": "@set"
    },
    "from": {
      "@id": "ujggraph:from",
      "@type": "@id"
    },
    "to": {
      "@id": "ujggraph:to",
      "@type": "@id"
    },
    "fromExit": {
      "@id": "ujggraph:fromExit",
      "@type": "@id"
    },
    "toEntry": {
      "@id": "ujggraph:toEntry",
      "@type": "@id"
    },
    "command": {
      "@id": "ujggraph:command",
      "@type": "@id"
    },
    "subjourneys": {
      "@id": "ujggraph:subjourneys",
      "@type": "@id",
      "@container": "@set"
    },
    "entryTransitions": {
      "@id": "ujggraph:entryTransitions",
      "@type": "@id",
      "@container": "@set"
    },
    "memberState": {
      "@id": "ujggraph:memberState",
      "@type": "@id"
    },
    "memberTransitions": {
      "@id": "ujggraph:memberTransitions",
      "@type": "@id",
      "@container": "@set"
    },
    "entrySelector": {
      "@id": "ujggraph:entrySelector",
      "@type": "@id"
    },
    "candidateJourneys": {
      "@id": "ujggraph:candidateJourneys",
      "@type": "@id",
      "@container": "@set"
    }
  }
}
