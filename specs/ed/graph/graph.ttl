@prefix ujg: <https://ujg.specs.openuji.org/ed/ns/core#> .
@prefix ujggraph: <https://ujg.specs.openuji.org/ed/ns/graph#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .


<https://ujg.specs.openuji.org/ed/ns/graph#> a owl:Ontology ;
  rdfs:label "UJG Graph Editor's Draft Vocabulary"@en ;
  dct:description "UJG Graph ontology declaration" .

### Classes

ujggraph:Journey a owl:Class ;
  rdfs:subClassOf ujg:Node .

ujggraph:JourneyEntry a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  rdfs:label "Journey Entry" ;
  rdfs:comment "An explicit entry contract for a Journey. A JourneyEntry points to the local State or CompositeState where traversal begins." .

ujggraph:JourneyEntryIndex a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  rdfs:label "Journey Index" ;
  rdfs:comment "A catalogue of addressable JourneyEntry contracts. A JourneyEntryIndex does not define traversal, ordering, reachability, or parent-owned progression." .

ujggraph:State a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  rdfs:label "State" ;
  rdfs:comment "A discrete node in the experience. A State is the only local vertex that declares entryTransitionRefs." .

ujggraph:CompositeState a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujggraph:State ;
  rdfs:label "Composite State" ;
  rdfs:comment "A local vertex that contains one or more child Journeys through subjourneyRefs. A CompositeState is a sibling of State, not a subclass of it, and it does not declare entryTransitionRefs." .

ujggraph:Transition a owl:Class ;
  rdfs:subClassOf ujg:Node .

ujggraph:AdjacentTransition a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujggraph:Transition, ujggraph:OutgoingTransition, ujggraph:InvokingTransition ;
  rdfs:label "Adjacent Transition" ;
  rdfs:comment "A structural edge between two local vertices of a Journey, or between two neighboring members of a StateCollection, that sit next to each other in the same experience frame and share a border. It describes movement across that border in both directions. It is not a Transition." .

ujggraph:Command a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  rdfs:label "Command" ;
  rdfs:comment "A stable semantic identity of an intentional invocation in the modeled experience." .

ujggraph:JourneyExit a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujggraph:State, ujggraph:CompositeState ;
  rdfs:label "Journey Exit" ;
  rdfs:comment "A terminal local graph vertex and exported completion contract of a journey." .

ujggraph:OutgoingTransition a owl:Class ;
  rdfs:subClassOf ujg:Node .

ujggraph:InvokingTransition a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujggraph:OutgoingTransition ;
  rdfs:label "Invoking Transition" ;
  rdfs:comment "An affordance that invokes a Journey through a JourneyEntry and resumes the source State occurrence when that Journey reaches one of its exits." .

ujggraph:StateCollection a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujggraph:Journey, ujggraph:JourneyEntry, ujggraph:JourneyEntryIndex, ujggraph:State, ujggraph:CompositeState, ujggraph:Transition, ujggraph:AdjacentTransition, ujggraph:OutgoingTransition, ujggraph:InvokingTransition, ujggraph:Command, ujggraph:JourneyExit ;
  rdfs:label "State Collection" ;
  rdfs:comment "Lets one State or CompositeState, its member State, stand for several similar parts of an experience, its members. It lists the member transitions that move the user from one member to another. It is not a local vertex and names no member." .

### Properties

ujggraph:label a owl:DatatypeProperty ;
  rdfs:domain ujg:Node ;
  rdfs:range xsd:string .

ujggraph:tags a owl:DatatypeProperty ;
  rdfs:domain ujg:Node ;
  rdfs:range xsd:string .

ujggraph:defaultEntryRef a owl:ObjectProperty ;
  rdfs:domain ujggraph:Journey ;
  rdfs:range ujggraph:JourneyEntry ;
  rdfs:label "default entry ref" ;
  rdfs:comment "References the JourneyEntry used, when declared, if traversal starts without a more specific entry selection." .

ujggraph:entryRefs a owl:ObjectProperty ;
  rdfs:range ujggraph:JourneyEntry ;
  rdfs:label "entry refs" ;
  rdfs:comment "References explicit JourneyEntry contracts. On Journey, entryRefs declares entries owned by that journey. On JourneyEntryIndex, entryRefs lists addressable entries without traversal semantics." .

ujggraph:stateRef a owl:ObjectProperty ;
  rdfs:domain ujggraph:JourneyEntry ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujggraph:State
      ujggraph:CompositeState
    )
  ] ;
  rdfs:label "state ref" ;
  rdfs:comment "References the local State or CompositeState where a JourneyEntry begins traversal." .

ujggraph:stateRefs a owl:ObjectProperty ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujggraph:State
      ujggraph:CompositeState
    )
  ] ;
  rdfs:comment "References State and CompositeState vertices. On Journey, stateRefs lists experiential local vertices." .

ujggraph:transitionRefs a owl:ObjectProperty ;
  rdfs:domain ujggraph:Journey ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujggraph:Transition
      ujggraph:AdjacentTransition
    )
  ] ;
  rdfs:comment "References the local Transition and AdjacentTransition nodes of a Journey. Member transitions are listed by StateCollection memberTransitionRefs instead." .

ujggraph:exitRefs a owl:ObjectProperty ;
  rdfs:domain ujggraph:Journey ;
  rdfs:range ujggraph:JourneyExit ;
  rdfs:label "exit refs" ;
  rdfs:comment "References the terminal exported local vertices declared by a journey." .

ujggraph:from a owl:ObjectProperty ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      ujggraph:Transition
      ujggraph:AdjacentTransition
    )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujggraph:State
      ujggraph:CompositeState
    )
  ] ;
  rdfs:comment "References the source local vertex of a Transition, or the vertex before the shared border of an AdjacentTransition. On a member transition of a StateCollection, it is the member State." .

ujggraph:to a owl:ObjectProperty ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      ujggraph:Transition
      ujggraph:AdjacentTransition
    )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujggraph:State
      ujggraph:CompositeState
      ujggraph:JourneyExit
    )
  ] ;
  rdfs:comment "References the destination local vertex of a Transition, or the vertex after the shared border of an AdjacentTransition. An AdjacentTransition's to value is never a JourneyExit. On a member transition of a StateCollection, it is the member State." .

ujggraph:fromExitRef a owl:ObjectProperty ;
  rdfs:domain ujggraph:Transition ;
  rdfs:range ujggraph:JourneyExit ;
  rdfs:label "from exit ref" ;
  rdfs:comment "Identifies the exported JourneyExit completed by one child journey of the CompositeState used as the transition's from value. This property is not a transition endpoint." .

ujggraph:toEntryRef a owl:ObjectProperty ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      ujggraph:Transition
      ujggraph:OutgoingTransition
      ujggraph:InvokingTransition
    )
  ] ;
  rdfs:range ujggraph:JourneyEntry ;
  rdfs:label "to entry ref" ;
  rdfs:comment "Selects a JourneyEntry. On a Transition, it refines entry into one child Journey of the CompositeState used as to. On an OutgoingTransition, it identifies the destination Journey entry contract. On an InvokingTransition, it identifies the entry contract of the invoked Journey." .

ujggraph:commandRef a owl:ObjectProperty ;
  rdfs:range ujggraph:Command ;
  rdfs:label "command ref" ;
  rdfs:comment "Associates a Transition, OutgoingTransition, or InvokingTransition with the stable semantic identity of an intentional invocation." .

ujggraph:subjourneyRefs a owl:ObjectProperty ;
  rdfs:domain ujggraph:CompositeState ;
  rdfs:range ujggraph:Journey ;
  rdfs:label "subjourney refs" ;
  rdfs:comment "References one or more child Journeys contained by a CompositeState." .

ujggraph:entryTransitionRefs a owl:ObjectProperty ;
  rdfs:domain ujggraph:State ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujggraph:OutgoingTransition
      ujggraph:InvokingTransition
    )
  ] ;
  rdfs:label "entry transition refs" ;
  rdfs:comment "References the entry transitions (OutgoingTransition or InvokingTransition nodes) available at a State. Only a State declares it. The listed transitions are available at occurrences of that State only: they are not inherited by States nested in a CompositeState, and a CompositeState does not declare them." .

ujggraph:memberStateRef a owl:ObjectProperty ;
  rdfs:domain ujggraph:StateCollection ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujggraph:State
      ujggraph:CompositeState
    )
  ] ;
  rdfs:label "member state ref" ;
  rdfs:comment "References the State or CompositeState that every member of a StateCollection is an occurrence of." .

ujggraph:memberTransitionRefs a owl:ObjectProperty ;
  rdfs:domain ujggraph:StateCollection ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujggraph:Transition
      ujggraph:AdjacentTransition
    )
  ] ;
  rdfs:label "member transition refs" ;
  rdfs:comment "References the Transition and AdjacentTransition nodes that move from one member of a StateCollection to another member. Their from and to values are the member State. A member transition leaves the member it starts from and enters another member; neither member is named in the Graph. They are not listed in any Journey's transitionRefs." .
