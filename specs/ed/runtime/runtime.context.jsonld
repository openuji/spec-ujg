{
  "@context": {
    "@version": 1.1,
    "ujgruntime": "https://ujg.specs.openuji.org/ed/ns/runtime#",
    "JourneyExecution": "ujgruntime:JourneyExecution",
    "RuntimeEvent": "ujgruntime:RuntimeEvent",
    "execution": {
      "@id": "ujgruntime:execution",
      "@type": "@id"
    },
    "previousEvent": {
      "@id": "ujgruntime:previousEvent",
      "@type": "@id"
    },
    "surfaceInstance": {
      "@id": "ujgruntime:surfaceInstance",
      "@type": "@id"
    },
    "payload": {
      "@id": "ujgruntime:payload",
      "@type": "@json"
    }
  }
}
