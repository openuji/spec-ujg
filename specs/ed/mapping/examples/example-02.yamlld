"@context":
  - https://ujg.specs.openuji.org/ed/ns/context.jsonld
  - https://ujg.specs.openuji.org/ed/ns/mapping.context.jsonld
id: https://example.com/ujg/mapping/execution-12345.jsonld
type: UJGDocument
nodes:
  - id: urn:mapping:execution-12345
    type: JourneyMapping
    mappedRuntime: urn:ujg:execution:12345
    mappedJourney: urn:ujg:journey:checkout
    mappedSteps:
      - id: urn:mapping:execution-12345:100
        type: MappedStep
        mappedEvent: urn:ujg:event:12345:100
        mappedState: urn:ujg:state:cart
      - id: urn:mapping:execution-12345:200
        type: MappedStep
        mappedEvent: urn:ujg:event:12345:200
        mappedState: urn:ujg:state:payment
        explainedByTransition: urn:ujg:transition:cart-to-payment
      - id: urn:mapping:execution-12345:300
        type: MappedStep
        mappedEvent: urn:ujg:event:12345:300
        mappedState: urn:ujg:state:confirmation
        explainedByTransition: urn:ujg:transition:payment-to-confirmation
  - id: urn:ujg:journey:checkout
    type: Journey
    states:
      - id: urn:ujg:state:cart
        type: State
        label: cart
      - id: urn:ujg:state:payment
        type: State
        label: payment
      - id: urn:ujg:state:confirmation
        type: State
        label: confirmation
    entries:
      - id: urn:ujg:entry:checkout
        type: JourneyEntry
        state: urn:ujg:state:cart
    transitions:
      - id: urn:ujg:transition:cart-to-payment
        type: Transition
        from: urn:ujg:state:cart
        to: urn:ujg:state:payment
      - id: urn:ujg:transition:payment-to-confirmation
        type: Transition
        from: urn:ujg:state:payment
        to: urn:ujg:state:confirmation
  - id: urn:ujg:execution:12345
    type: JourneyExecution
  - id: urn:ujg:surface:cart
    type: Surface
    graphNode: urn:ujg:state:cart
  - id: urn:ujg:instance:cart
    type: SurfaceInstance
    surface: urn:ujg:surface:cart
  - id: urn:ujg:event:12345:100
    type: RuntimeEvent
    execution: urn:ujg:execution:12345
    surfaceInstance: urn:ujg:instance:cart
  - id: urn:ujg:surface:payment
    type: Surface
    graphNode: urn:ujg:state:payment
  - id: urn:ujg:instance:payment
    type: SurfaceInstance
    surface: urn:ujg:surface:payment
  - id: urn:ujg:event:12345:200
    type: RuntimeEvent
    execution: urn:ujg:execution:12345
    surfaceInstance: urn:ujg:instance:payment
    previousEvent: urn:ujg:event:12345:100
  - id: urn:ujg:surface:confirmation
    type: Surface
    graphNode: urn:ujg:state:confirmation
  - id: urn:ujg:instance:confirmation
    type: SurfaceInstance
    surface: urn:ujg:surface:confirmation
  - id: urn:ujg:event:12345:300
    type: RuntimeEvent
    execution: urn:ujg:execution:12345
    surfaceInstance: urn:ujg:instance:confirmation
    previousEvent: urn:ujg:event:12345:200
