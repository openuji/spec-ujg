{
  "@context": {
    "@version": 1.1,
    "ujgmapping": "https://ujg.specs.openuji.org/ed/ns/mapping#",
    "JourneyMapping": "ujgmapping:JourneyMapping",
    "MappedStep": "ujgmapping:MappedStep",
    "mappedJourney": {
      "@id": "ujgmapping:mappedJourney",
      "@type": "@id"
    },
    "mappedRuntime": {
      "@id": "ujgmapping:mappedRuntime",
      "@type": "@id"
    },
    "mappedSteps": {
      "@id": "ujgmapping:mappedSteps",
      "@type": "@id",
      "@container": "@set"
    },
    "mappedEvent": {
      "@id": "ujgmapping:mappedEvent",
      "@type": "@id"
    },
    "observedAffordanceEvent": {
      "@id": "ujgmapping:observedAffordanceEvent",
      "@type": "@id"
    },
    "mappedState": {
      "@id": "ujgmapping:mappedState",
      "@type": "@id"
    },
    "explainedByTransition": {
      "@id": "ujgmapping:explainedByTransition",
      "@type": "@id"
    }
  }
}
