@prefix ujggraph: <https://ujg.specs.openuji.org/ed/ns/graph#> .
@prefix ujgruntime: <https://ujg.specs.openuji.org/ed/ns/runtime#> .
@prefix ujgmapping: <https://ujg.specs.openuji.org/ed/ns/mapping#> .
@prefix ujgmappingshape: <https://ujg.specs.openuji.org/ed/ns/mapping.shape#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ujgmappingshape:StateLikeShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:or (
    [ sh:class ujggraph:State ]
    [ sh:class ujggraph:CompositeState ]
  ) .

ujgmappingshape:TransitionLikeShape a sh:NodeShape ;
  sh:nodeKind sh:IRI ;
  sh:or (
    [ sh:class ujggraph:Transition ]
    [ sh:class ujggraph:AdjacentTransition ]
    [ sh:class ujggraph:OutgoingTransition ]
  ) .

ujgmappingshape:JourneyMappingShape a sh:NodeShape ;
  sh:targetClass ujgmapping:JourneyMapping ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujgmapping:mappedJourney ;
    sh:class ujggraph:Journey ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujgmapping:mappedRuntime ;
    sh:class ujgruntime:JourneyExecution ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujgmapping:mappedSteps ;
    sh:class ujgmapping:MappedStep ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
  ] ;

  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "JourneyMapping segments for one JourneyExecution must not map the same RuntimeEvent more than once." ;
    sh:select """
      SELECT $this ?event
      WHERE {
        $this ujgmapping:mappedRuntime ?runtime ;
              ujgmapping:mappedSteps ?step .
        ?step ujgmapping:mappedEvent ?event .

        ?other a ujgmapping:JourneyMapping ;
               ujgmapping:mappedRuntime ?runtime ;
               ujgmapping:mappedSteps ?otherStep .
        ?otherStep ujgmapping:mappedEvent ?event .

        FILTER ($this != ?other)
      }
    """ ;
  ] .

ujgmappingshape:MappedStepShape a sh:NodeShape ;
  sh:targetClass ujgmapping:MappedStep ;
  sh:nodeKind sh:IRI ;

  sh:property [
    sh:path ujgmapping:mappedEvent ;
    sh:class ujgruntime:RuntimeEvent ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujgmapping:observedAffordanceEvent ;
    sh:class ujgruntime:RuntimeEvent ;
    sh:nodeKind sh:IRI ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujgmapping:mappedState ;
    sh:node ujgmappingshape:StateLikeShape ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ujgmapping:explainedByTransition ;
    sh:node ujgmappingshape:TransitionLikeShape ;
    sh:maxCount 1 ;
  ] .
