@prefix ujg: <https://ujg.specs.openuji.org/tr/1.0-rc4/ns/core#> .
@prefix ujggraph: <https://ujg.specs.openuji.org/tr/1.0-rc4/ns/graph#> .
@prefix ujgobservability: <https://ujg.specs.openuji.org/tr/1.0-rc4/ns/observability#> .
@prefix ujgoperability: <https://ujg.specs.openuji.org/tr/1.0-rc4/ns/operability#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://ujg.specs.openuji.org/tr/1.0-rc4/ns/operability#> a owl:Ontology ;
  rdfs:label "UJG Operability 1.0 Vocabulary"@en ;
  dct:description "UJG Operability ontology declaration" .

### Classes

ujgoperability:TransitionMaterialization a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  rdfs:label "Transition Materialization" ;
  rdfs:comment "One way to perform one Graph transition through one input modality, described as materialization steps. Several materializations of the same transition are alternatives. A TransitionMaterialization does not change the transition." .

ujgoperability:MoveStep a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujgoperability:ActivationStep, ujgoperability:ShortcutStep ;
  rdfs:label "Move Step" ;
  rdfs:comment "A materialization step in which the user moves to another object, such as the next button. Only the last step of a materialization takes the materialized transition." .

ujgoperability:ActivationStep a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujgoperability:MoveStep, ujgoperability:ShortcutStep ;
  rdfs:label "Activation Step" ;
  rdfs:comment "A materialization step in which the user performs the default action of the object they are at: the focused object, or the object pointed at. Any of the platform's activation gestures performs it." .

ujgoperability:ShortcutStep a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujgoperability:MoveStep, ujgoperability:ActivationStep ;
  rdfs:label "Shortcut Step" ;
  rdfs:comment "A materialization step in which the user performs the shortcut that an object exposes. It acts on that object without the user reaching it first." .

ujgoperability:FocusMoveKind a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujgoperability:MoveKind ;
  rdfs:label "Focus Move Kind" ;
  rdfs:comment "A platform-neutral kind of focus move, used through input modalities that move focus, such as a keyboard. A platform adapter performs it with the gestures of its platform and input modality." .

ujgoperability:MoveKind a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:disjointWith ujgoperability:FocusMoveKind ;
  rdfs:label "Move Kind" ;
  rdfs:comment "A platform-neutral kind of move that does not move focus, such as moving the pointer onto an object or moving the view by a page. A platform adapter performs it with the gestures of its platform and input modality." .

ujgoperability:MaterializationDirection a owl:Class ;
  rdfs:subClassOf ujg:Node ;
  owl:equivalentClass [
    a owl:Class ;
    owl:oneOf ( ujgoperability:forward ujgoperability:backward )
  ] ;
  rdfs:label "Materialization Direction" ;
  rdfs:comment "Which of the two movements of an AdjacentTransition a TransitionMaterialization performs. An AdjacentTransition has exactly two movements, so forward and backward are the only directions." .

### Standard individuals

ujgoperability:nextStop a owl:NamedIndividual, ujgoperability:FocusMoveKind ;
  rdfs:label "Next stop"@en ;
  rdfs:comment "Moves focus to the next stop of sequential focus navigation."@en .

ujgoperability:previousStop a owl:NamedIndividual, ujgoperability:FocusMoveKind ;
  rdfs:label "Previous stop"@en ;
  rdfs:comment "Moves focus to the previous stop of sequential focus navigation."@en .

ujgoperability:nextItem a owl:NamedIndividual, ujgoperability:FocusMoveKind ;
  rdfs:label "Next item"@en ;
  rdfs:comment "Moves focus to the next item inside a composite widget, such as the next tab of a tab list."@en .

ujgoperability:previousItem a owl:NamedIndividual, ujgoperability:FocusMoveKind ;
  rdfs:label "Previous item"@en ;
  rdfs:comment "Moves focus to the previous item inside a composite widget."@en .

ujgoperability:firstItem a owl:NamedIndividual, ujgoperability:FocusMoveKind ;
  rdfs:label "First item"@en ;
  rdfs:comment "Moves focus to the first item inside a composite widget."@en .

ujgoperability:lastItem a owl:NamedIndividual, ujgoperability:FocusMoveKind ;
  rdfs:label "Last item"@en ;
  rdfs:comment "Moves focus to the last item inside a composite widget."@en .

ujgoperability:pointAt a owl:NamedIndividual, ujgoperability:MoveKind ;
  rdfs:label "Point at"@en ;
  rdfs:comment "Moves the pointer onto the object that the step's locator names, such as hovering over a menu item to open its submenu."@en .

ujgoperability:nextPage a owl:NamedIndividual, ujgoperability:MoveKind ;
  rdfs:label "Next page"@en ;
  rdfs:comment "Moves the view forward by one page, such as PageDown, a mouse wheel, or a swipe in a carousel."@en .

ujgoperability:previousPage a owl:NamedIndividual, ujgoperability:MoveKind ;
  rdfs:label "Previous page"@en ;
  rdfs:comment "Moves the view back by one page."@en .

ujgoperability:forward a owl:NamedIndividual, ujgoperability:MaterializationDirection ;
  rdfs:label "Forward"@en ;
  rdfs:comment "Moves from the AdjacentTransition's from vertex to its to vertex. For a member AdjacentTransition, moves to the neighboring member after the border."@en .

ujgoperability:backward a owl:NamedIndividual, ujgoperability:MaterializationDirection ;
  rdfs:label "Backward"@en ;
  rdfs:comment "Moves from the AdjacentTransition's to vertex to its from vertex. For a member AdjacentTransition, moves to the neighboring member before the border."@en .

### Properties

ujgoperability:materializationTransitionRef a owl:ObjectProperty ;
  rdfs:domain ujgoperability:TransitionMaterialization ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujggraph:Transition
      ujggraph:AdjacentTransition
      ujggraph:OutgoingTransition
      ujggraph:InvokingTransition
    )
  ] ;
  rdfs:label "materialization transition ref" ;
  rdfs:comment "References the Graph transition that a TransitionMaterialization performs. A Transition with fromExitRef is taken when the child exit is reached, not by a user action, so it is never materialized." .

ujgoperability:materializationModalityRef a owl:ObjectProperty ;
  rdfs:domain ujgoperability:TransitionMaterialization ;
  rdfs:range ujgobservability:InputModality ;
  rdfs:label "materialization modality ref" ;
  rdfs:comment "References the input modality through which a TransitionMaterialization performs its transition." .

ujgoperability:materializationStepRefs a owl:ObjectProperty ;
  rdfs:domain ujgoperability:TransitionMaterialization ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujgoperability:MoveStep
      ujgoperability:ActivationStep
      ujgoperability:ShortcutStep
    )
  ] ;
  rdfs:label "materialization step refs" ;
  rdfs:comment "References the materialization steps of a TransitionMaterialization. The values form a set; step order comes from stepPreviousRef." .

ujgoperability:materializationStartLocatorRef a owl:ObjectProperty ;
  rdfs:domain ujgoperability:TransitionMaterialization ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujgobservability:AccessibleLocator
      ujgobservability:CustomLocator
    )
  ] ;
  rdfs:label "materialization start locator ref" ;
  rdfs:comment "References a locator for the object the user is at before the first step." .

ujgoperability:materializationSourceStateRef a owl:ObjectProperty ;
  rdfs:domain ujgoperability:TransitionMaterialization ;
  rdfs:range ujggraph:State ;
  rdfs:label "materialization source state ref" ;
  rdfs:comment "References the State in which the steps are performed when the transition does not determine it: a State that lists the materialized entry transition, or a State nested in the CompositeState that the materialized transition leaves." .

ujgoperability:materializationDirectionRef a owl:ObjectProperty ;
  rdfs:domain ujgoperability:TransitionMaterialization ;
  rdfs:range ujgoperability:MaterializationDirection ;
  rdfs:label "materialization direction ref" ;
  rdfs:comment "References which of the two movements of the materialized AdjacentTransition a TransitionMaterialization performs." .

ujgoperability:stepPreviousRef a owl:ObjectProperty ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      ujgoperability:MoveStep
      ujgoperability:ActivationStep
      ujgoperability:ShortcutStep
    )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujgoperability:MoveStep
      ujgoperability:ActivationStep
      ujgoperability:ShortcutStep
    )
  ] ;
  rdfs:label "step previous ref" ;
  rdfs:comment "References the materialization step that a step follows. The first step of a materialization follows no step." .

ujgoperability:stepLocatorRef a owl:ObjectProperty ;
  rdfs:domain [
    a owl:Class ;
    owl:unionOf (
      ujgoperability:MoveStep
      ujgoperability:ActivationStep
      ujgoperability:ShortcutStep
    )
  ] ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujgobservability:AccessibleLocator
      ujgobservability:CustomLocator
    )
  ] ;
  rdfs:label "step locator ref" ;
  rdfs:comment "References a locator for the object that a materialization step reaches or acts on." .

ujgoperability:stepMoveKindRef a owl:ObjectProperty ;
  rdfs:domain ujgoperability:MoveStep ;
  rdfs:range [
    a owl:Class ;
    owl:unionOf (
      ujgoperability:FocusMoveKind
      ujgoperability:MoveKind
    )
  ] ;
  rdfs:label "step move kind ref" ;
  rdfs:comment "References the kind of move that a MoveStep performs: a FocusMoveKind, or a MoveKind for a move that does not move focus." .
