---
import Panel from '@/components/astro/Panel.astro';
import EditorDraftLayout from '@/layouts/EditorDraftLayout.astro';
import { getDocumentFamily, getDocumentModuleLevel, getDocuments } from '@/lib/load';
import { type Document } from '@openuji/speculator';
import MaturityPill from '@/components/astro/speculator/w3c-cg/MaturityPill.astro';

const documents = await getDocuments('ed');
const moduleDocuments = documents.filter((doc) => getDocumentFamily(doc) === 'module');
const extensionDocuments = documents.filter((doc) => getDocumentFamily(doc) === 'extension');

const familySections: Array<{
  id: string;
  title: string;
  description: string;
  documents: Document[];
}> = [
  {
    id: 'spec-family',
    title: 'Spec Family',
    description:
      'Foundational UJG modules and supporting drafts that define the shared interoperability baseline.',
    documents: documents.filter((doc) => getDocumentFamily(doc) === 'spec'),
  },
  {
    id: 'optional-modules',
    title: 'First-Level Optional Modules',
    description:
      'Optional modules whose dependencies are limited to the main spec family. They publish their own ontology, JSON-LD context, and SHACL artifacts without depending on other optional modules.',
    documents: moduleDocuments.filter((doc) => getDocumentModuleLevel(doc) === 1),
  },
  {
    id: 'second-level-optional-modules',
    title: 'Second-Level Optional Modules',
    description:
      'Optional modules that depend on one or more first-level optional modules, plus any needed main spec family modules.',
    documents: moduleDocuments.filter((doc) => getDocumentModuleLevel(doc) === 2),
  },
  {
    id: 'third-level-optional-modules',
    title: 'Third-Level Optional Modules',
    description:
      'Optional modules that depend on one or more second-level optional modules and build on their vocabulary, plus any needed first-level or main spec family modules.',
    documents: moduleDocuments.filter((doc) => getDocumentModuleLevel(doc) === 3),
  },
  {
    id: 'document-extensions',
    title: 'Document Extensions',
    description:
      'Optional interoperable JSON structures attached to a UJGDocument. They do not participate directly in the UJG RDF graph and may use their own validation mechanisms.',
    documents: extensionDocuments,
  },
].filter((section) => section.documents.length > 0);
---

<EditorDraftLayout title="Editor's Draft">
  <h1>Editor's Draft (ED)</h1>
  <section class="card-grid">
    <Panel variant="contrast">
      <p>
        The ED workspace captures the newest ideas, examples, and proposals. Documents can change at
        any time. You can use it for:
      </p>
      <ul>
        <li>Participate in discussions and contribute.</li>
        <li>Track upcoming changes while implementing.</li>
        <li>Prototype the newest journey patterns.</li>
      </ul>
    </Panel>
  </section>

  {
    familySections.map((section) => (
      <section class="flow" id={section.id}>
        {section.id === 'optional-modules' && <a id="supported-extensions" aria-hidden="true" />}
        <div class="flow__header">
          <h2 class="font-bold pb-2">{section.title}</h2>
          <p>{section.description}</p>
        </div>
        <div class="spec-card-grid">
          {section.documents.map((doc: Document) => (
            <a
              href={`/ed/${doc.id}`}
              class="card min-h-auto hover:bg-accent-soft/40 hover:translate-y-[1px] transition-[background-color,transform]"
            >
              <h3>{doc.metadata?.title}</h3>
              <MaturityPill metadata={doc.metadata || {}} />
              View Spec →
            </a>
          ))}
        </div>
      </section>
    ))
  }
</EditorDraftLayout>
