---
interface Props {
  title?: string;
  bodyClass?: string;
  canonical?: string | false;
  robots?: string;
}
const {
  title = 'User Journey Mapping Specifications',
  bodyClass = '',
  canonical,
  robots,
} = Astro.props;
import '@/styles/design-system.css';
import { ClientRouter } from 'astro:transitions';

const canonicalBase = Astro.site ?? new URL('https://ujg.specs.openuji.org');
const rawPathname = Astro.url.pathname;
const normalizedPathname =
  rawPathname === '/'
    ? '/'
    : rawPathname
        .replace(/\/index\.html$/, '')
        .replace(/\.html$/, '')
        .replace(/\/$/, '') || '/';
const canonicalHref =
  canonical === false
    ? undefined
    : new URL(canonical ?? normalizedPathname, canonicalBase).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta
      name="description"
      content="A family of open specifications that model user journeys as graphs of states and transitions."
    />
    {robots && <meta name="robots" content={robots} />}
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <slot name="head" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,1..1000&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        const storageKey = 'ujg-theme';
        try {
          const stored = localStorage.getItem(storageKey);
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          } else {
            const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
            document.documentElement.setAttribute('data-theme', systemTheme);
          }
        } catch {
          const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
          document.documentElement.setAttribute('data-theme', systemTheme);
        }
      })();
    </script>
    <ClientRouter />
    <script is:inline>
      (function () {
        if (window._smoothScrollSetup) return;
        window._smoothScrollSetup = true;

        const shouldReduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        function highlightTarget(target) {
          if (!target) return;
          target.classList.remove('target-highlight');
          // Trigger reflow to restart animation
          void target.offsetWidth;
          target.classList.add('target-highlight');

          // Optional: remove class after animation finishes to keep DOM clean
          // but it's not strictly necessary as it's a one-shot animation
          setTimeout(() => {
            target.classList.remove('target-highlight');
          }, 2100);
        }

        function handleLinkClick(e) {
          const link = e.target.closest('a');
          if (!link?.hash || link.origin !== location.origin) return;

          const urlPath = link.pathname.replace(/\/$/, '');
          const locPath = location.pathname.replace(/\/$/, '');
          if (urlPath !== locPath) return;

          const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
          if (!target) return;

          e.preventDefault();
          target.scrollIntoView({
            behavior: shouldReduceMotion.matches ? 'auto' : 'smooth',
          });
          history.pushState(null, '', link.hash);
          highlightTarget(target);
        }

        function handleHashChange() {
          const hash = location.hash;
          if (hash) {
            const target = document.getElementById(decodeURIComponent(hash.slice(1)));
            if (target) {
              highlightTarget(target);
            }
          }
        }

        // Content that arrives after the browser's own hash jump — Mermaid SVGs
        // replacing several screens of source text, lazy images without
        // dimensions, webfonts — resizes the page above the target and drags
        // the reader away from it. Re-scrolling after the fact corrects the
        // position but the reader sees every correction as a jump, so instead
        // keep the target pinned: measure how far it drifted and undo that in
        // the ResizeObserver callback, which runs after layout but before
        // paint, making the compensation invisible.
        function settleHashScroll() {
          if (!location.hash || typeof ResizeObserver === 'undefined') return;

          const targetId = decodeURIComponent(location.hash.slice(1));
          let anchorTop = null;
          let observer = null;
          let stopTimer;
          let cancelled = false;

          function teardown() {
            clearTimeout(stopTimer);
            if (observer) observer.disconnect();
            observer = null;
            window.removeEventListener('wheel', cancel);
            window.removeEventListener('touchmove', cancel);
            window.removeEventListener('pointerdown', cancel);
            window.removeEventListener('keydown', cancel);
            window.removeEventListener('ujg:mermaid-rendered', repin);
          }

          function cancel() {
            cancelled = true;
            teardown();
          }

          function repin() {
            if (cancelled || anchorTop === null) return;

            const target = document.getElementById(targetId);
            if (!target) return;

            const drift = target.getBoundingClientRect().top - anchorTop;
            if (Math.abs(drift) < 1) return;

            window.scrollBy(0, drift);

            // Scrolling clamps at the end of the document, so re-measure
            // instead of assuming the correction fully landed.
            anchorTop = target.getBoundingClientRect().top;
          }

          function start() {
            if (cancelled) return;

            const target = document.getElementById(targetId);
            if (!target) return;

            // Establish the resting position once. scrollIntoView honours the
            // heading's scroll-margin-top, so the sticky header never covers it.
            target.scrollIntoView({ behavior: 'auto' });
            anchorTop = target.getBoundingClientRect().top;

            observer = new ResizeObserver(repin);
            observer.observe(document.body);
            document.querySelectorAll('.mermaid-container').forEach(function (el) {
              observer.observe(el);
            });

            // Late content stops arriving; stop watching so ordinary scrolling
            // is never second-guessed.
            stopTimer = setTimeout(teardown, 5000);
          }

          // Deliberate input hands control back to the reader immediately.
          // Note: we never listen for 'scroll', since our own correction
          // would cancel itself.
          window.addEventListener('wheel', cancel, { passive: true });
          window.addEventListener('touchmove', cancel, { passive: true });
          window.addEventListener('pointerdown', cancel);
          window.addEventListener('keydown', cancel);
          window.addEventListener('ujg:mermaid-rendered', repin);

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', start, { once: true });
          } else {
            start();
          }
        }

        function init() {
          document.addEventListener('click', handleLinkClick, { capture: true });
          // Also highlight on page load if hash exists
          handleHashChange();
          settleHashScroll();
        }

        document.addEventListener('astro:page-load', init);
        init();
      })();
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
    <footer class="site-footer border-t border-border bg-panel backdrop-blur-md mt-auto">
      <div
        class="max-w-content mx-auto px-4 md:px-12 py-4 grid grid-cols-[1fr_auto_1fr] items-center"
      >
        <div
          class="footer-meta text-xs text-secondary-foreground col-start-2 justify-self-center text-center"
        >
          <slot name="footer-meta"> Open User Journey Initiative</slot>
        </div>
        <button
          type="button"
          class="theme-switcher js-theme-switcher col-start-3 justify-self-end"
          aria-label="Toggle color theme"></button>
      </div>
    </footer>

    <script>
      import { themeMode, syncThemeMode, toggleThemeMode, watchSystemTheme } from '@/stores/theme';

      const g = globalThis as typeof globalThis & {
        __ujgThemeUiInit?: boolean;
        __ujgThemeUnsub?: () => void;
        __ujgThemeWatchCleanup?: () => void;
      };

      const updateButtonLabel = () => {
        const button = document.querySelector('.js-theme-switcher');
        if (!(button instanceof HTMLButtonElement)) return;

        const theme = themeMode.get();
        button.textContent = theme === 'dark' ? 'Theme: Dark' : 'Theme: Light';
        button.setAttribute('aria-pressed', String(theme === 'dark'));
      };

      const bindThemeSwitcher = () => {
        const button = document.querySelector('.js-theme-switcher');
        if (!(button instanceof HTMLButtonElement)) return;

        if (button.dataset.bound !== 'true') {
          button.dataset.bound = 'true';
          button.addEventListener('click', () => {
            toggleThemeMode();
          });
        }

        updateButtonLabel();
      };

      const initThemeUi = () => {
        syncThemeMode();
        bindThemeSwitcher();
      };

      if (!g.__ujgThemeUiInit) {
        g.__ujgThemeUiInit = true;
        g.__ujgThemeUnsub?.();
        g.__ujgThemeUnsub = themeMode.subscribe(() => {
          updateButtonLabel();
        });
        g.__ujgThemeWatchCleanup?.();
        g.__ujgThemeWatchCleanup = watchSystemTheme();
        document.addEventListener('astro:page-load', initThemeUi);
      }

      initThemeUi();
    </script>
  </body>
</html>
