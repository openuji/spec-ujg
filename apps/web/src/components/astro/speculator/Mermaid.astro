---
interface Props {
  code: string;
  id?: string;
}

const { code, id } = Astro.props;
---

<div class="mermaid-container" id={id}>
  <pre class="mermaid" data-mermaid-pending="true" data-mermaid-source={code}>{code}</pre>
</div>

<script>
  import mermaid from 'mermaid';

  const MERMAID_SELECTOR = 'pre.mermaid';
  const COLOR_SCHEME_QUERY = '(prefers-color-scheme: dark)';
  const MERMAID_FONT_FAMILY = 'Inter, system-ui, sans-serif';
  const MERMAID_FONT_SIZE = '13px';
  let isRendering = false;
  let rerenderQueued = false;
  let renderSequence = 0;

  function isDarkTheme() {
    const forcedTheme = document.documentElement.getAttribute('data-theme');
    if (forcedTheme === 'dark') return true;
    if (forcedTheme === 'light') return false;
    return window.matchMedia(COLOR_SCHEME_QUERY).matches;
  }

  function getMermaidTheme(isDark: boolean) {
    if (isDark) {
      return {
        theme: 'base',
        themeVariables: {
          darkMode: true,
          background: 'transparent',
          textColor: '#f3f4f8',
          titleColor: '#f3f4f8',
          lineColor: '#95a2cb',
          primaryColor: '#1a2340',
          primaryTextColor: '#f3f4f8',
          primaryBorderColor: '#8f80ff',
          secondaryColor: '#162036',
          secondaryTextColor: '#f3f4f8',
          tertiaryColor: '#1d2b4a',
          tertiaryTextColor: '#f3f4f8',
          mainBkg: '#1a2340',
          nodeBkg: '#1a2340',
          noteBkgColor: '#2f2712',
          noteTextColor: '#f8e7a1',
          noteBorderColor: '#c99a2e',
          edgeLabelBackground: '#27272a',
          clusterBkg: '#10182e',
          clusterBorder: '#33416b',
          labelBackground: '#10182e',
          fontFamily: MERMAID_FONT_FAMILY,
          fontSize: MERMAID_FONT_SIZE,
        },
      };
    }

    return {
      theme: 'default',
      themeVariables: {
        fontFamily: MERMAID_FONT_FAMILY,
        fontSize: MERMAID_FONT_SIZE,
      },
    };
  }

  function collectMermaidNodes() {
    const nodes = document.querySelectorAll(MERMAID_SELECTOR);
    const readyNodes: Array<{ node: HTMLElement; source: string }> = [];

    for (const node of nodes) {
      let source = node.getAttribute('data-mermaid-source');

      if (!source) {
        // If Mermaid already processed this node but source is missing, skip it.
        // Using rendered SVG text as source can trigger UnknownDiagramError.
        if (node.getAttribute('data-processed') === 'true') continue;

        source = node.textContent ?? '';
        if (!source.trim()) continue;
      }

      node.setAttribute('data-mermaid-source', source);
      readyNodes.push({ node: node as HTMLElement, source });
    }

    return readyNodes;
  }

  async function initMermaid() {
    const isDark = isDarkTheme();
    const theme = getMermaidTheme(isDark);
    const nodes = collectMermaidNodes();
    if (!nodes.length) return;

    mermaid.initialize({
      startOnLoad: false,
      ...theme,
    });

    for (const entry of nodes) {
      const { node, source } = entry;

      try {
        const renderId = `ujg-mermaid-${Date.now()}-${++renderSequence}`;
        const { svg, bindFunctions } = await mermaid.render(renderId, source);
        node.innerHTML = svg;
        node.setAttribute('data-processed', 'true');
        if (bindFunctions) bindFunctions(node);
      } catch (error) {
        node.textContent = source;
        node.removeAttribute('data-processed');
        console.warn('Mermaid render failed', error);
      } finally {
        // Failed renders fall back to the full source, so drop the cap either way.
        node.removeAttribute('data-mermaid-pending');
      }
    }
  }

  async function renderMermaidQueued() {
    if (isRendering) {
      rerenderQueued = true;
      return;
    }

    isRendering = true;
    do {
      rerenderQueued = false;
      try {
        await initMermaid();
      } catch (error) {
        console.warn('Mermaid render failed', error);
      }
    } while (rerenderQueued);
    isRendering = false;

    // Diagrams replace their own source text, so the page above an anchor can
    // shrink by several screens here. Let listeners re-measure.
    window.dispatchEvent(new CustomEvent('ujg:mermaid-rendered'));
  }

  function queueMermaidRender() {
    requestAnimationFrame(() => {
      void renderMermaidQueued();
    });
  }

  if (!window.__ujgMermaidInit) {
    window.__ujgMermaidInit = true;
    document.addEventListener('astro:page-load', queueMermaidRender);
    document.addEventListener('astro:after-swap', queueMermaidRender);
    window.matchMedia(COLOR_SCHEME_QUERY).addEventListener('change', queueMermaidRender);
    window.addEventListener('ujg:theme-change', queueMermaidRender);
  }

  queueMermaidRender();
</script>

<style>
  .mermaid-container {
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    text-align: center;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  .mermaid-container pre.mermaid {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    color: inherit;
    display: flex;
    justify-content: center;
  }

  /* Before Mermaid runs, the raw source can stand several screens tall and then
     collapse into a compact SVG, moving everything below it. Reserve a small
     fixed box instead, so the swap stays close to a no-op for layout and the
     reader never sees a flash of diagram source. */
  .mermaid-container pre.mermaid[data-mermaid-pending] {
    height: 6rem;
    overflow: hidden;
    visibility: hidden;
  }

  .mermaid-container :global(svg) {
    max-width: 100%;
    height: auto;
    font-size: 13px !important;
    overflow: visible;
  }

  .mermaid-container :global(svg text),
  .mermaid-container :global(svg tspan),
  .mermaid-container :global(svg .label),
  .mermaid-container :global(svg .nodeLabel),
  .mermaid-container :global(svg .edgeLabel),
  .mermaid-container :global(svg .cluster-label),
  .mermaid-container :global(svg foreignObject),
  .mermaid-container :global(svg foreignObject div),
  .mermaid-container :global(svg foreignObject span),
  .mermaid-container :global(svg foreignObject p) {
    font-size: 13px !important;
    line-height: 1.25 !important;
  }

  .mermaid-container :global(svg foreignObject) {
    overflow: visible;
  }

  .mermaid-container :global(.edgeLabel text),
  .mermaid-container :global(.edgeLabel tspan),
  .mermaid-container :global(.edgeLabel span p) {
    font-size: 12px !important;
  }

  .mermaid-container :global(.cluster-label span p) {
    font-size: 13px !important;
    padding: 0.2rem 0.4rem !important;
  }

  :global(:root[data-theme='dark']) .mermaid-container :global(.note) {
    fill: #2f2712 !important;
    stroke: #c99a2e !important;
  }

  :global(:root[data-theme='dark']) .mermaid-container :global(.noteText),
  :global(:root[data-theme='dark']) .mermaid-container :global(.noteText tspan) {
    fill: #f8e7a1 !important;
    color: #f8e7a1 !important;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .mermaid-container :global(.note) {
      fill: #2f2712 !important;
      stroke: #c99a2e !important;
    }

    :global(:root:not([data-theme='light'])) .mermaid-container :global(.noteText),
    :global(:root:not([data-theme='light'])) .mermaid-container :global(.noteText tspan) {
      fill: #f8e7a1 !important;
      color: #f8e7a1 !important;
    }
  }
</style>
